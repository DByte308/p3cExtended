From a2ed59135787cd492d923e88035edc7d39f94c23 Mon Sep 17 00:00:00 2001
From: DByte308 <69403407+DByte308@users.noreply.github.com>
Date: Thu, 26 Nov 2026 10:40:04 +0100
Subject: [PATCH 1/3] t/constellation: hold position after 0.5 s without an
 optical solve

Dead reckoning from the controller IMU had no time limit and kept
POSITION_TRACKED set, so an occluded controller drifted by metres per
second. Past CONSTELLATION_MAX_DEAD_RECKON_S (default 0.5 s) without an
optical solve, hold position, zero velocity, and clear POSITION_TRACKED
and LINEAR_VELOCITY_VALID while continuing to integrate gyro orientation.
---
 .../constellation/optimizer/sensor_fusion.cpp | 37 ++++++++++++++++++-
 1 file changed, 35 insertions(+), 2 deletions(-)

diff --git a/src/xrt/tracking/constellation/optimizer/sensor_fusion.cpp b/src/xrt/tracking/constellation/optimizer/sensor_fusion.cpp
index 77421dd59..04e22a400 100644
--- a/src/xrt/tracking/constellation/optimizer/sensor_fusion.cpp
+++ b/src/xrt/tracking/constellation/optimizer/sensor_fusion.cpp
@@ -166,6 +166,22 @@ constexpr double kMaxSeedVelocityMetersPerSecond = 10.0;
 
 //! The maximum gap between keyframes in seconds
 constexpr double kMaxTimeBetweenKeyframesSeconds = 5.0;
+/*!
+ * How long the position may be dead reckoned from the IMU alone after the last optical solve. Past this the
+ * position is held where it was and flagged as not tracked (orientation keeps integrating the gyro): double
+ * integrated accelerometer noise otherwise runs away by metres per second and drags the blob search prior with it.
+ * Override with CONSTELLATION_MAX_DEAD_RECKON_S.
+ */
+static double
+maxDeadReckonSeconds()
+{
+	static const double v = [] {
+		const char *e = getenv("CONSTELLATION_MAX_DEAD_RECKON_S");
+		double d = e ? atof(e) : 0.0;
+		return d > 0.0 ? d : 0.5;
+	}();
+	return v;
+}
 
 constexpr bool kOptimizeWorldGravity = false;
 
@@ -1245,8 +1261,10 @@ static void
 integrateToTimestampHistory(const xrt_vec3_f64 &world_gravity,
                             DeviceSolveState &inout_solve,
                             const std::span<const xrt_imu_sample> imu_samples,
-                            m_relation_history *relation_history)
+                            m_relation_history *relation_history,
+                            timepoint_ns optical_ns)
 {
+	const double max_reckon_s = maxDeadReckonSeconds();
 	assert(imu_samples.size() > 0);
 
 	const Vector3d gravity_vec = map_vec3_f64(world_gravity);
@@ -1269,6 +1287,8 @@ integrateToTimestampHistory(const xrt_vec3_f64 &world_gravity,
 
 	Vector3d world_velocity = map_vec3_f64(inout_solve.world_velocity);
 	for (const auto &sample : imu_samples) {
+		const bool stale = time_ns_to_s(sample.timestamp_ns - optical_ns) > max_reckon_s;
+		const Vector3d held_position = T_world_device;
 		integrateOnce(pose_ns,        //
 		              sample,         //
 		              T_world_device, //
@@ -1284,6 +1304,12 @@ integrateToTimestampHistory(const xrt_vec3_f64 &world_gravity,
 
 		Q_world_model = (Q_world_imu * Q_model_imu.conjugate()).normalized();
 
+		if (stale) {
+			// No optical fix for too long: hold the position, keep only the gyro orientation.
+			T_world_device = held_position;
+			world_velocity = Vector3d::Zero();
+		}
+
 		xrt_space_relation relation = {
 		    .relation_flags = static_cast<xrt_space_relation_flags>(
 		        XRT_SPACE_RELATION_ORIENTATION_VALID_BIT | XRT_SPACE_RELATION_POSITION_VALID_BIT |
@@ -1299,6 +1325,12 @@ integrateToTimestampHistory(const xrt_vec3_f64 &world_gravity,
 		// World-frame angular velocity is the same for every frame on the device, so the IMU's will do.
 		map_vec3(relation.angular_velocity) =
 		    (Q_world_imu * (map_vec3_f64(sample.gyro_rad_secs) - gyro_bias)).cast<float>();
+		if (stale) {
+			relation.relation_flags = static_cast<xrt_space_relation_flags>(
+			    relation.relation_flags &
+			    ~(XRT_SPACE_RELATION_POSITION_TRACKED_BIT | XRT_SPACE_RELATION_LINEAR_VELOCITY_VALID_BIT));
+			relation.linear_velocity = XRT_VEC3_ZERO;
+		}
 
 		m_relation_history_push_or_update(relation_history, &relation, pose_ns);
 	}
@@ -3212,7 +3244,8 @@ SensorFusion::reckonToLatestImu(DeviceSolveState &inout_solve)
 	integrateToTimestampHistory(this->snapshot.world_gravity,                                     //
 	                            inout_solve,                                                      //
 	                            std::span<const xrt_imu_sample>(samples_buf.data(), num_samples), //
-	                            device.relation_history);                                         //
+	                            device.relation_history,                                          //
+	                            device.latest_solve ? device.latest_solve->time_ns : inout_solve.time_ns);
 
 	SF_TRACE(this, "Filled relation history for device %d from %" PRIi64 " to %" PRIi64, device.id, start_ns,
 	         samples_buf[num_samples - 1].timestamp_ns);
