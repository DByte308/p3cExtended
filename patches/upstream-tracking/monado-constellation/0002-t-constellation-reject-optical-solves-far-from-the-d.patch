index b9b56a307..e7c7764b3 100644
--- a/src/xrt/tracking/constellation/t_constellation_tracker_internal.hpp
+++ b/src/xrt/tracking/constellation/t_constellation_tracker_internal.hpp
@@ -315,7 +315,8 @@ public: // Methods (t_constellation_tracker.cpp)
 	bool
 	processSampleFast(CameraSample &sample);
 
-	void
+	//! Accepts the pose for the device; false if it was dropped (no blobs left, or rejected by the prior gate).
+	bool
 	pushPose(CameraSample &camera_sample,
 	         DeviceState &device_state,
 	         Device *device,
