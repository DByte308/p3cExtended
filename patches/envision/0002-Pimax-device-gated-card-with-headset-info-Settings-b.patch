+                    let kl = gtk::Label::builder().label(k).xalign(0.0).css_classes(["dim-label"]).build();
+                    let vl = gtk::Label::builder().label(v).xalign(0.0).hexpand(true).selectable(true).wrap(true).build();
+                    widgets.info_grid.attach(&kl, 0, i as i32, 1, 1);
+                    widgets.info_grid.attach(&vl, 1, i as i32, 1, 1);
+                }
+            }
         }
     }
 
