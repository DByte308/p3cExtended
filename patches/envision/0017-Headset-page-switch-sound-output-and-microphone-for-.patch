diff --git a/src/ui/pimax_common.rs b/src/ui/pimax_common.rs
index e2e8299..b709f3e 100644
--- a/src/ui/pimax_common.rs
+++ b/src/ui/pimax_common.rs
@@ -317,6 +317,68 @@ impl Ctx {
         row
     }
 
+    /// Audio device choice for the session: "Don't change", "Headset (automatic)" or one of the devices present
+    /// now. A stored device that is not connected stays selectable so the choice is not lost. The list is read
+    /// again whenever the row is shown.
+    pub fn audio_row(&self, k: &'static str, title: &str, kind: crate::audio_switch::Kind) -> adw::ComboRow {
+        use crate::audio_switch::{self as audio, HEADSET};
+        let values: Rc<RefCell<Vec<Option<String>>>> = Rc::new(RefCell::new(Vec::new()));
+        let updating = Rc::new(std::cell::Cell::new(false));
+        let row = adw::ComboRow::builder().title(title).subtitle_lines(0).build();
+
+        let rebuild = {
+            let c = self.clone();
+            let values = values.clone();
+            let updating = updating.clone();
+            move |row: &adw::ComboRow| {
+                let cur = c.get(k).filter(|v| !v.is_empty());
+                let ok = audio::available();
+                let devices = if ok { audio::list(kind) } else { Vec::new() };
+                let headset = audio::headset_device(&devices).map(|d| d.description.clone());
+                let mut labels = vec![
+                    "Don't change".to_string(),
+                    match &headset {
+                        Some(h) => format!("Headset (automatic): {h}"),
+                        None => "Headset (automatic, not connected)".to_string(),
+                    },
+                ];
+                let mut vals = vec![None, Some(HEADSET.to_string())];
+                for d in &devices {
+                    labels.push(d.description.clone());
+                    vals.push(Some(d.name.clone()));
+                }
+                if let Some(cur) = cur.as_ref().filter(|c| *c != HEADSET && !vals.iter().any(|v| v.as_ref() == Some(*c))) {
+                    labels.push(format!("{cur} (not connected)"));
+                    vals.push(Some(cur.clone()));
+                }
+                updating.set(true);
+                row.set_model(Some(&gtk::StringList::new(&labels.iter().map(String::as_str).collect::<Vec<_>>())));
+                row.set_selected(vals.iter().position(|v| *v == cur).unwrap_or(0) as u32);
+                updating.set(false);
+                *values.borrow_mut() = vals;
+                row.set_sensitive(ok);
+                row.set_subtitle(if ok {
+                    "Set as the system default while the session runs, restored when it stops"
+                } else {
+                    "Needs pactl with PulseAudio or PipeWire (pipewire-pulse); not found"
+                });
+            }
+        };
+        rebuild(&row);
+        {
+            let c = self.clone();
+            row.connect_selected_notify(move |row| {
+                if updating.get() {
+                    return;
+                }
+                let v = values.borrow().get(row.selected() as usize).cloned().flatten();
+                c.set(k, v);
+            });
+        }
+        row.connect_map(move |row| rebuild(row));
+        row
+    }
+
