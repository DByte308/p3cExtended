diff --git a/src/audio_switch.rs b/src/audio_switch.rs
new file mode 100644
index 0000000..6968a9f
--- /dev/null
+++ b/src/audio_switch.rs
@@ -0,0 +1,204 @@
+//! Switch the default audio output and microphone while a VR session runs, and restore them afterwards.
+//!
+//! Uses `pactl`, which talks to PulseAudio and to PipeWire's PulseAudio server (pipewire-pulse), so it works the
+//! same on any desktop (Plasma, GNOME, others) and any distro that ships one of the two. Device names (stable
+//! across reboots) are stored, not indices.
+
+use std::process::Command;
+use tracing::{info, warn};
+
+/// Stored choice meaning "the headset's own audio device".
+pub const HEADSET: &str = "headset";
+
+/// USB vendor id of the headset.
+const HEADSET_VENDOR: &str = "0x34a4";
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Kind {
+    Output,
+    Input,
+}
+
+impl Kind {
+    fn list_arg(self) -> &'static str {
+        match self {
+            Self::Output => "sinks",
+            Self::Input => "sources",
+        }
+    }
+    fn block_prefix(self) -> &'static str {
+        match self {
+            Self::Output => "Sink #",
+            Self::Input => "Source #",
+        }
+    }
+    fn default_label(self) -> &'static str {
+        match self {
+            Self::Output => "Default Sink: ",
+            Self::Input => "Default Source: ",
+        }
+    }
+    fn set_cmd(self) -> &'static str {
+        match self {
+            Self::Output => "set-default-sink",
+            Self::Input => "set-default-source",
+        }
+    }
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Device {
+    /// Stable device name (what gets stored and passed to pactl).
+    pub name: String,
+    /// Human readable description.
+    pub description: String,
+    /// The headset's own audio device.
+    pub headset: bool,
+    /// USB vendor id of the device, if it reports one.
+    pub vendor_id: Option<String>,
+}
+
+fn pactl(args: &[&str]) -> Option<String> {
+    // C locale: the field labels ("Name:", "Description:") are translated otherwise.
+    let out = Command::new("pactl").args(args).env("LC_ALL", "C").output().ok()?;
+    out.status.success().then(|| String::from_utf8_lossy(&out.stdout).into_owned())
+}
+
+/// Whether a PulseAudio-compatible sound server is reachable.
+pub fn available() -> bool {
+    pactl(&["info"]).is_some()
+}
+
+/// Audio devices of one kind. Monitor sources (the "what you hear" copy of each output) are left out.
+pub fn list(kind: Kind) -> Vec<Device> {
+    let Some(text) = pactl(&["list", kind.list_arg()]) else {
+        return Vec::new();
+    };
+    let mut out = Vec::new();
+    let mut cur: Option<(Device, bool, Option<String>, Option<String>)> = None;
+    let finish = |d: Option<(Device, bool, Option<String>, Option<String>)>, out: &mut Vec<Device>| {
+        if let Some((mut dev, monitor, vendor, product)) = d {
+            if monitor || dev.name.is_empty() {
+                return;
+            }
+            // A device of the headset itself (USB vendor 34a4), its audio chip (USB 3654:5678), or a description
+            // naming the headset.
+            dev.headset = vendor.as_deref() == Some(HEADSET_VENDOR)
+                || (vendor.as_deref() == Some("0x3654") && product.as_deref() == Some("0x5678"))
+                || dev.description.to_lowercase().contains("pimax");
+            dev.vendor_id = vendor;
+            out.push(dev);
+        }
+    };
+    for line in text.lines() {
+        if line.starts_with(kind.block_prefix()) {
+            finish(cur.take(), &mut out);
+            cur = Some((Device { name: String::new(), description: String::new(), headset: false, vendor_id: None }, false, None, None));
+            continue;
+        }
+        let Some((dev, monitor, vendor, product)) = cur.as_mut() else { continue };
+        let t = line.trim();
+        let prop = |key: &str| {
+            t.strip_prefix(key)
+                .and_then(|r| r.trim_start().strip_prefix('='))
+                .map(|v| v.trim().trim_matches('"').to_string())
+        };
+        if let Some(v) = t.strip_prefix("Name: ") {
+            dev.name = v.to_string();
+        } else if let Some(v) = t.strip_prefix("Description: ") {
+            dev.description = v.to_string();
+        } else if let Some(v) = t.strip_prefix("Monitor of Sink: ") {
+            *monitor |= v != "n/a";
+        } else if let Some(v) = prop("device.class") {
+            *monitor |= v == "monitor";
+        } else if let Some(v) = prop("device.vendor.id") {
+            *vendor = Some(v);
+        } else if let Some(v) = prop("device.product.id") {
+            *product = Some(v);
+        }
+    }
+    finish(cur.take(), &mut out);
+    out
+}
+
+/// The device "Headset (automatic)" stands for: a device of the headset itself (USB vendor 34a4) before the
+/// separate audio chip.
+pub fn headset_device(devices: &[Device]) -> Option<&Device> {
+    devices
+        .iter()
+        .find(|d| d.vendor_id.as_deref() == Some(HEADSET_VENDOR))
+        .or_else(|| devices.iter().find(|d| d.headset))
+}
+
+/// Name of the current default device.
+pub fn current_default(kind: Kind) -> Option<String> {
+    pactl(&["info"])?
+        .lines()
+        .find_map(|l| l.strip_prefix(kind.default_label()).map(|v| v.trim().to_string()))
+        .filter(|v| !v.is_empty())
+}
+
+fn set_default(kind: Kind, name: &str) -> bool {
+    let ok = pactl(&[kind.set_cmd(), name]).is_some();
+    if !ok {
+        warn!("audio: could not set the default {kind:?} to {name}");
+    }
+    ok
+}
+
+/// Device name for a stored choice: None/empty = do not change, HEADSET = the headset's device, else the name
+/// itself if that device is present right now.
+fn resolve(kind: Kind, choice: Option<&str>) -> Option<String> {
+    let choice = choice.filter(|c| !c.is_empty())?;
+    let devices = list(kind);
+    let found = if choice == HEADSET {
+        headset_device(&devices).map(|d| d.name.clone())
+    } else {
+        devices.into_iter().find(|d| d.name == choice).map(|d| d.name)
+    };
+    if found.is_none() {
+        warn!("audio: {kind:?} device {choice:?} is not connected; leaving the default unchanged");
+    }
+    found
+}
+
+/// What a session switched: (kind, default before, device set).
+#[derive(Debug, Default)]
+pub struct Switched(Vec<(Kind, String, String)>);
+
+/// Switch the defaults for the session. Returns what to restore afterwards.
+pub fn apply(output: Option<&str>, input: Option<&str>) -> Switched {
+    let mut done = Switched::default();
+    if output.is_none_or(str::is_empty) && input.is_none_or(str::is_empty) {
+        return done;
+    }
+    if !available() {
+        warn!("audio: pactl or a PulseAudio/PipeWire sound server is not available; audio switching skipped");
+        return done;
+    }
+    for (kind, choice) in [(Kind::Output, output), (Kind::Input, input)] {
+        let Some(target) = resolve(kind, choice) else { continue };
+        let before = current_default(kind).unwrap_or_default();
+        if before == target {
+            continue;
+        }
+        if set_default(kind, &target) {
+            info!("audio: default {kind:?} {before} -> {target}");
+            done.0.push((kind, before, target));
+        }
+    }
+    done
+}
+
+/// Undo `apply`, but only where the default is still the device the session set (a change made by hand during
+/// the session is kept).
+pub fn restore(s: Switched) {
+    for (kind, before, set) in s.0 {
+        if before.is_empty() || current_default(kind).as_deref() != Some(set.as_str()) {
+            continue;
+        }
+        if set_default(kind, &before) {
+            info!("audio: default {kind:?} restored to {before}");
+        }
+    }
+}
