From 81bc6c1cd2ff6c4d3f91fc740dc7d22d7d548e90 Mon Sep 17 00:00:00 2001
From: DByte308 <69403407+DByte308@users.noreply.github.com>
Date: Tue, 24 Nov 2026 07:52:51 +0100
Subject: [PATCH 10/13] Pimax pages: Rendering tile on Home, clean decimal
 values, clearer row hints

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/ui/pimax_common.rs |  6 +++++-
 src/ui/pimax_pages.rs  | 24 +++++++++++++++++++-----
 2 files changed, 24 insertions(+), 6 deletions(-)

diff --git a/src/ui/pimax_common.rs b/src/ui/pimax_common.rs
index 05f7c3d..403414d 100644
--- a/src/ui/pimax_common.rs
+++ b/src/ui/pimax_common.rs
@@ -71,6 +71,7 @@ pub struct PimaxStatus {
     pub ipd_mm: Option<f64>,
     pub eye_tracking: Option<EyeTrackingStatus>,
     pub foveation: Option<bool>,
+    pub fov_percent: Option<f64>,
     pub controllers: Option<ControllersStatus>,
 }
 
@@ -177,9 +178,12 @@ impl Ctx {
     pub fn num_row(&self, k: &'static str, title: &str, desc: &str, unset: f64, min: f64, max: f64, step: f64) -> adw::SpinRow {
         let c = self.clone();
         let val = self.get(k).and_then(|v| v.parse().ok()).unwrap_or(unset);
+        // Decimals of the step, so float accumulation (68.86000000000001) never reaches the env var.
+        let decimals = (0..6).find(|d| ((step * 10f64.powi(*d)).round() - step * 10f64.powi(*d)).abs() < 1e-6).unwrap_or(6) as usize;
         super::preference_rows::spin_row(title, Some(desc), val, min, max, step, move |adj| {
             let v = adj.value();
-            c.set(k, (v != unset).then(|| if step >= 1.0 { format!("{v:.0}") } else { format!("{v}") }));
+            let is_unset = (v - unset).abs() < step / 2.0;
+            c.set(k, (!is_unset).then(|| format!("{v:.decimals$}")));
         })
     }
 
diff --git a/src/ui/pimax_pages.rs b/src/ui/pimax_pages.rs
index 1848abf..41c5a2b 100644
--- a/src/ui/pimax_pages.rs
+++ b/src/ui/pimax_pages.rs
@@ -64,6 +64,8 @@ pub struct PimaxSummaryWidgets {
     refresh: gtk::Label,
     ipd: gtk::Label,
     eye: gtk::Label,
+    rendering: gtk::Label,
+    rendering_caption: gtk::Label,
     controllers: gtk::Label,
     hint: gtk::Label,
 }
@@ -86,18 +88,20 @@ impl SimpleComponent for PimaxSummary {
             .column_spacing(12)
             .row_spacing(12)
             .min_children_per_line(1)
-            .max_children_per_line(5)
+            .max_children_per_line(6)
             .build();
         let (t_headset, headset) = tile("video-display-symbolic", "Headset");
         let (t_refresh, refresh) = tile("view-refresh-symbolic", "Refresh rate");
         let (t_ipd, ipd) = tile("view-dual-symbolic", "Lens IPD");
         let (t_eye, eye) = tile("view-reveal-symbolic", "Eye tracking");
+        let (t_render, rendering) = tile("applications-graphics-symbolic", "Rendering");
         let (t_ctrl, controllers) = tile("input-gaming-symbolic", "Controllers");
-        for t in [&t_headset, &t_refresh, &t_ipd, &t_eye, &t_ctrl] {
+        for t in [&t_headset, &t_refresh, &t_ipd, &t_eye, &t_render, &t_ctrl] {
             flow.append(t);
         }
         // the headset tile's caption is the connection state
         let headset_caption = t_headset.last_child().and_then(|c| c.last_child()).and_downcast::<gtk::Label>().unwrap();
+        let rendering_caption = t_render.last_child().and_then(|c| c.last_child()).and_downcast::<gtk::Label>().unwrap();
         let hint = hint_label(STALE_HINT);
         hint.set_margin_start(4);
         root.append(&flow);
@@ -107,7 +111,7 @@ impl SimpleComponent for PimaxSummary {
         root.set_visible(model.plugged);
         ComponentParts {
             model,
-            widgets: PimaxSummaryWidgets { headset, headset_caption, refresh, ipd, eye, controllers, hint },
+            widgets: PimaxSummaryWidgets { headset, headset_caption, refresh, ipd, eye, rendering, rendering_caption, controllers, hint },
         }
     }
 
@@ -137,6 +141,16 @@ impl SimpleComponent for PimaxSummary {
             Some(_) => "Not calibrated".into(),
             None => DASH.into(),
         });
+        w.rendering.set_label(match st.and_then(|s| s.foveation) {
+            Some(true) => "Foveated",
+            Some(false) => "Standard",
+            None => DASH,
+        });
+        w.rendering_caption.set_label(&match st.and_then(|s| s.fov_percent) {
+            Some(p) if p < 100.0 => format!("Rendering \u{b7} FOV {p:.0} %"),
+            Some(_) => "Rendering \u{b7} Full FOV".into(),
+            None => "Rendering".into(),
+        });
         w.controllers.set_label(&match st {
             Some(s) => {
                 let dot = |left| if s.controller(left).connected == Some(true) { "\u{25cf}" } else { "\u{25cb}" };
@@ -298,7 +312,7 @@ impl SimpleComponent for HeadsetPage {
         adv_group.add(&ctx.num_row(
             "PIMAX_LENS_SEP_MM",
             "Lens centre distance (mm)",
-            "Distortion centre spacing; change only if both eyes don't fuse",
+            "Distortion centre spacing; 68.81 = unset (driver default for this headset); change only if both eyes don't fuse",
             68.81,
             60.0,
             76.0,
@@ -325,7 +339,7 @@ impl SimpleComponent for HeadsetPage {
             let dir = view_dir.to_string_lossy().to_string();
             super::preference_rows::switch_row(
                 "Capture headset view",
-                Some(&format!("Debug: saves about 5 images per second of the left eye to {dir}; costs some GPU time")),
+                Some(&format!("Debug: saves about 5 images per second of the left eye to {dir}; slows the compositor and turns off its fast path")),
                 ctx.get("XRT_MIRROR_DUMP").is_some(),
                 move |_, on| c.set("XRT_MIRROR_DUMP", on.then(|| dir.clone())),
             )
-- 
