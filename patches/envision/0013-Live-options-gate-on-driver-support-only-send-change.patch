+impl MainView {
+    /// New eye page with the current env; keeps the old page's result message and service state.
+    fn rebuild_eye_page(&mut self, sender: &AsyncComponentSender<Self>) {
+        if self.eyetracking_page.model().is_running() {
+            self.eye_reload_pending = true;
+            return;
+        }
+        let (result, calib_error) = self.eyetracking_page.model().carry_state();
+        let eye = EyeTrackingPage::builder()
+            .launch(self.pimax_init.clone())
+            .forward(sender.input_sender(), MainViewMsg::FromPimax);
+        eye.emit(EyeTrackingMsg::XRServiceActiveChanged(self.xrservice_active && self.xrservice_ready));
+        eye.emit(EyeTrackingMsg::Restore(result, calib_error));
+        self.pimax_slots[1].set_child(Some(eye.widget()));
+        self.eyetracking_page = eye;
+    }
+}
