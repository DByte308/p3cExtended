+++ b/src/headset_edid.rs
@@ -13,8 +13,13 @@ use std::fs;
 /// PnP manufacturer id of the headset display.
 const HEADSET_MANUFACTURER: &str = "PVR";
 
+/// Each 128-byte EDID block sums to 0 (mod 256); a half-read or corrupted block must not yield rates.
+fn checksum_ok(block: &[u8]) -> bool {
+    block.iter().fold(0u8, |a, b| a.wrapping_add(*b)) == 0
+}
+
 fn manufacturer(edid: &[u8]) -> Option<String> {
-    if edid.len() < 128 || edid[..8] != [0x00, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0x00] {
+    if edid.len() < 128 || edid[..8] != [0x00, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0x00] || !checksum_ok(&edid[..128]) {
         return None;
     }
     let id = u16::from_be_bytes([edid[8], edid[9]]);
@@ -26,7 +31,12 @@ fn manufacturer(edid: &[u8]) -> Option<String> {
 }
 
 fn rate(clock_hz: f64, h_total: u32, v_total: u32) -> Option<u32> {
-    (h_total > 0 && v_total > 0 && clock_hz > 0.0).then(|| (clock_hz / (h_total as f64 * v_total as f64)).round() as u32)
+    if h_total == 0 || v_total == 0 || clock_hz <= 0.0 {
+        return None;
+    }
+    // Anything outside a plausible display range is a broken descriptor, never a rate to use.
+    let hz = (clock_hz / (h_total as f64 * v_total as f64)).round() as u32;
+    (24..=255).contains(&hz).then_some(hz)
 }
 
 /// 18-byte detailed timing descriptor (base block, CTA-861 block).
@@ -54,7 +64,7 @@ pub fn edid_rates(edid: &[u8]) -> BTreeSet<u32> {
         return out;
     }
     out.extend([54, 72, 90, 108].iter().filter_map(|&o| dtd_rate(&edid[o..o + 18])));
-    for block in edid[128..].chunks_exact(128) {
+    for block in edid[128..].chunks_exact(128).filter(|b| checksum_ok(b)) {
         match block[0] {
             // CTA-861: DTDs from the offset in byte 2 up to the checksum
             0x02 => {
@@ -127,6 +137,9 @@ mod tests {
         // "PVR": P=16 V=22 R=18 -> 0b0_10000_10110_10010
         let id: u16 = (16 << 10) | (22 << 5) | 18;
         e[8..10].copy_from_slice(&id.to_be_bytes());
+        e[127] = 0u8.wrapping_sub(e[..127].iter().fold(0u8, |a, b| a.wrapping_add(*b)));
         assert_eq!(manufacturer(&e).as_deref(), Some("PVR"));
+        e[20] ^= 1; // corrupted block
+        assert_eq!(manufacturer(&e), None);
     }
 }
