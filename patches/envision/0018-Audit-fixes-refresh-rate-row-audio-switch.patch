 /// What a session switched: (kind, default before, device set).
 #[derive(Debug, Default)]
 pub struct Switched(Vec<(Kind, String, String)>);
 
-/// Switch the defaults for the session. Returns what to restore afterwards.
-pub fn apply(output: Option<&str>, input: Option<&str>) -> Switched {
+/// Whether there is anything to switch (None or empty = do not change).
+pub fn wanted(output: Option<&str>, input: Option<&str>) -> bool {
+    !(output.is_none_or(str::is_empty) && input.is_none_or(str::is_empty))
+}
+
+/// Switch the defaults for the session and return what to restore afterwards. The headset's audio device can
+/// appear only once the headset powers up, so a device that is missing is looked for again every second for up
+/// to `wait`. Blocking: call it off the UI thread.
+pub fn apply(output: Option<&str>, input: Option<&str>, wait: std::time::Duration) -> Switched {
     let mut done = Switched::default();
-    if output.is_none_or(str::is_empty) && input.is_none_or(str::is_empty) {
+    if !wanted(output, input) {
         return done;
     }
     if !available() {
         warn!("audio: pactl or a PulseAudio/PipeWire sound server is not available; audio switching skipped");
         return done;
     }
-    for (kind, choice) in [(Kind::Output, output), (Kind::Input, input)] {
-        let Some(target) = resolve(kind, choice) else { continue };
-        let before = current_default(kind).unwrap_or_default();
-        if before == target {
-            continue;
-        }
-        if set_default(kind, &target) {
-            info!("audio: default {kind:?} {before} -> {target}");
-            done.0.push((kind, before, target));
+    let mut pending: Vec<(Kind, &str)> = [(Kind::Output, output), (Kind::Input, input)]
+        .into_iter()
+        .filter_map(|(k, c)| c.filter(|c| !c.is_empty()).map(|c| (k, c)))
+        .collect();
+    let until = std::time::Instant::now() + wait;
+    loop {
+        pending.retain(|&(kind, choice)| {
+            let Some(target) = resolve(kind, choice) else { return true };
+            let before = current_default(kind).unwrap_or_default();
+            if before != target && set_default(kind, &target) {
+                info!("audio: default {kind:?} {before} -> {target}");
+                done.0.push((kind, before, target));
+            }
+            false
+        });
+        if pending.is_empty() || std::time::Instant::now() >= until {
+            break;
         }
+        std::thread::sleep(std::time::Duration::from_secs(1));
+    }
+    for (kind, choice) in pending {
+        warn!("audio: {kind:?} device {choice:?} did not appear; leaving the default unchanged");
     }
     done
 }
 
+impl Switched {
+    /// Fold a later switch (session restart) into this one: the defaults from before the first switch are kept
+    /// as the restore target, and the device set last is what restore expects to find.
+    pub fn merge_later(&mut self, later: Switched) {
+        for (kind, before, set) in later.0 {
+            match self.0.iter_mut().find(|(k, _, _)| *k == kind) {
+                Some(e) => e.2 = set,
+                None => self.0.push((kind, before, set)),
+            }
+        }
+    }
+}
+
 /// Undo `apply`, but only where the default is still the device the session set (a change made by hand during
 /// the session is kept).
 pub fn restore(s: Switched) {
