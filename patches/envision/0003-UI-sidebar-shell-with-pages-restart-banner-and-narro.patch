+//! The application shell: a sidebar (navigation) + content (pages) layout.
+//!
+//! Every page except Logs lives in a `adw::Bin` slot that is wrapped in a
+//! scrolled, clamped container. To put real content in a page, call
+//! `shell.<name>_slot.set_child(Some(&widget))`.
+
+use crate::constants::APP_NAME;
+use adw::prelude::*;
+use gtk::glib;
+
+pub struct PageDef {
+    pub id: &'static str,
+    pub title: &'static str,
+    pub icon: &'static str,
+}
+
+pub const PAGES: &[PageDef] = &[
+    PageDef {
+        id: "home",
+        title: "Home",
+        icon: "go-home-symbolic",
+    },
+    PageDef {
+        id: "headset",
+        title: "Headset",
+        icon: "video-display-symbolic",
+    },
+    PageDef {
+        id: "eyetracking",
+        title: "Eye Tracking",
+        icon: "view-reveal-symbolic",
+    },
+    PageDef {
+        id: "controllers",
+        title: "Controllers",
+        icon: "input-gaming-symbolic",
+    },
+    PageDef {
+        id: "devices",
+        title: "Devices & Apps",
+        icon: "applications-system-symbolic",
+    },
+    PageDef {
+        id: "logs",
+        title: "Logs",
+        icon: "utilities-terminal-symbolic",
+    },
+];
+
+#[derive(Clone)]
+pub struct Shell {
+    pub split_view: adw::NavigationSplitView,
+    pub banner: adw::Banner,
+    pub home_slot: adw::Bin,
+    /// Fill with `set_child(Some(..))` to replace the placeholder.
+    #[allow(dead_code)]
+    pub headset_slot: adw::Bin,
+    /// Fill with `set_child(Some(..))` to replace the placeholder.
+    #[allow(dead_code)]
+    pub eyetracking_slot: adw::Bin,
+    /// Fill with `set_child(Some(..))` to replace the placeholder.
+    #[allow(dead_code)]
+    pub controllers_slot: adw::Bin,
+    pub devices_slot: adw::Bin,
+    pub logs_slot: adw::Bin,
+}
+
+/// Placeholder content for a page that doesn't have real widgets yet.
+pub fn placeholder_page(icon: &str, title: &str) -> gtk::Widget {
+    adw::StatusPage::builder()
+        .icon_name(icon)
+        .title(title)
+        .description("Coming soon")
+        .vexpand(true)
+        .build()
+        .upcast()
+}
+
+/// Wraps a slot in a vertically scrolling page with a clamp and margins.
+fn scrolled_clamp(slot: &adw::Bin) -> gtk::Widget {
+    let clamp = adw::Clamp::builder()
+        .maximum_size(720)
+        .tightening_threshold(600)
+        .margin_top(24)
+        .margin_bottom(24)
+        .margin_start(24)
+        .margin_end(24)
+        .child(slot)
+        .build();
+    gtk::ScrolledWindow::builder()
+        .hscrollbar_policy(gtk::PolicyType::Never)
+        .vexpand(true)
+        .child(&clamp)
+        .build()
+        .upcast()
+}
+
+fn app_menu() -> gtk::gio::Menu {
+    let menu = gtk::gio::Menu::new();
+    let s1 = gtk::gio::Menu::new();
+    s1.append(Some("_Preferences"), Some("win.preferences"));
+    s1.append(Some("_Developer mode"), Some("win.debugviewtoggle"));
+    menu.append_section(None, &s1);
+    let s2 = gtk::gio::Menu::new();
+    s2.append(Some("Change _theme"), Some("win.thememanager"));
+    s2.append(Some("_About"), Some("win.about"));
+    menu.append_section(None, &s2);
+    menu
+}
+
+fn sidebar_row(def_icon: &str, title: &str) -> gtk::ListBoxRow {
+    let b = gtk::Box::new(gtk::Orientation::Horizontal, 12);
+    b.set_margin_top(6);
+    b.set_margin_bottom(6);
+    b.append(&gtk::Image::from_icon_name(def_icon));
+    let l = gtk::Label::new(Some(title));
+    l.set_xalign(0.0);
+    l.set_hexpand(true);
+    b.append(&l);
+    gtk::ListBoxRow::builder().child(&b).build()
+}
+
+impl Shell {
+    pub fn new() -> Self {
+        let home_slot = adw::Bin::new();
+        let devices_slot = adw::Bin::new();
+        let logs_slot = adw::Bin::new();
+        let headset_slot = adw::Bin::new();
+        let eyetracking_slot = adw::Bin::new();
+        let controllers_slot = adw::Bin::new();
+        // ---- placeholders: replace with the real widgets ----
+        headset_slot.set_child(Some(&placeholder_page(PAGES[1].icon, PAGES[1].title)));
+        eyetracking_slot.set_child(Some(&placeholder_page(PAGES[2].icon, PAGES[2].title)));
+        controllers_slot.set_child(Some(&placeholder_page(PAGES[3].icon, PAGES[3].title)));
+
+        // ---- content ----
+        let stack = adw::ViewStack::new();
+        stack.set_vexpand(true);
+        let page_widgets: [(&str, gtk::Widget); 6] = [
+            ("home", scrolled_clamp(&home_slot)),
+            ("headset", scrolled_clamp(&headset_slot)),
+            ("eyetracking", scrolled_clamp(&eyetracking_slot)),
+            ("controllers", scrolled_clamp(&controllers_slot)),
+            ("devices", scrolled_clamp(&devices_slot)),
+            ("logs", logs_slot.clone().upcast()),
+        ];
+        for (id, w) in &page_widgets {
+            stack.add_named(w, Some(id));
+        }
+
+        let banner = adw::Banner::builder()
+            .title("Settings changed. Restart the session to apply them.")
+            .button_label("Restart")
+            .revealed(false)
+            .build();
+        let content_title = adw::WindowTitle::new(PAGES[0].title, "");
+        let content_header = adw::HeaderBar::new();
+        content_header.set_title_widget(Some(&content_title));
+        let content_tv = adw::ToolbarView::new();
+        content_tv.add_top_bar(&content_header);
+        content_tv.add_top_bar(&banner);
+        content_tv.set_content(Some(&stack));
+        let content_page = adw::NavigationPage::new(&content_tv, PAGES[0].title);
+
+        // ---- sidebar ----
+        let sidebar_header = adw::HeaderBar::new();
+        sidebar_header.set_title_widget(Some(&adw::WindowTitle::new(APP_NAME, "")));
+        sidebar_header.pack_end(
+            &gtk::MenuButton::builder()
+                .icon_name("open-menu-symbolic")
+                .tooltip_text("Menu")
+                .menu_model(&app_menu())
+                .build(),
+        );
+        let list = gtk::ListBox::new();
+        list.add_css_class("navigation-sidebar");
+        for def in PAGES {
+            list.append(&sidebar_row(def.icon, def.title));
+        }
+        let settings_list = gtk::ListBox::new();
+        settings_list.add_css_class("navigation-sidebar");
+        settings_list.set_selection_mode(gtk::SelectionMode::None);
+        settings_list.append(&sidebar_row("emblem-system-symbolic", "Settings"));
+
+        let sidebar_box = gtk::Box::new(gtk::Orientation::Vertical, 0);
+        let sidebar_scroll = gtk::ScrolledWindow::builder()
+            .hscrollbar_policy(gtk::PolicyType::Never)
+            .vexpand(true)
+            .child(&list)
+            .build();
+        sidebar_box.append(&sidebar_scroll);
+        sidebar_box.append(&gtk::Separator::new(gtk::Orientation::Horizontal));
+        sidebar_box.append(&settings_list);
+        let sidebar_tv = adw::ToolbarView::new();
+        sidebar_tv.add_top_bar(&sidebar_header);
+        sidebar_tv.set_content(Some(&sidebar_box));
+        let sidebar_page = adw::NavigationPage::new(&sidebar_tv, APP_NAME);
+
+        let split_view = adw::NavigationSplitView::builder()
+            .sidebar(&sidebar_page)
+            .content(&content_page)
+            .hexpand(true)
+            .vexpand(true)
+            .min_sidebar_width(220.0)
+            .max_sidebar_width(280.0)
+            .show_content(false)
+            .build();
+
+        // ---- wiring ----
+        let select_page = glib::clone!(
+            #[weak]
+            stack,
+            #[weak]
+            content_title,
+            #[weak]
+            content_page,
+            move |idx: i32| {
+                if let Some(def) = usize::try_from(idx).ok().and_then(|i| PAGES.get(i)) {
+                    stack.set_visible_child_name(def.id);
+                    content_title.set_title(def.title);
+                    content_page.set_title(def.title);
+                }
+            }
+        );
+        list.connect_row_selected(glib::clone!(
+            #[strong]
+            select_page,
+            move |_, row| {
+                if let Some(row) = row {
+                    select_page(row.index());
+                }
+            }
+        ));
+        list.connect_row_activated(glib::clone!(
+            #[weak]
+            split_view,
+            move |_, _| split_view.set_show_content(true)
+        ));
+        list.select_row(list.row_at_index(0).as_ref());
+        settings_list.connect_row_activated(|l, _| {
+            let _ = l.activate_action("win.preferences", None);
+        });
+
+        Self {
+            split_view,
+            banner,
+            home_slot,
+            headset_slot,
+            eyetracking_slot,
+            controllers_slot,
+            devices_slot,
+            logs_slot,
+        }
+    }
+}
+
+impl Default for Shell {
+    fn default() -> Self {
+        Self::new()
+    }
+}
