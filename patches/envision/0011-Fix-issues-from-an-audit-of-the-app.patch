+
+/// Store a global env var change. The render scale has its own preference (it is always passed to the service as
+/// XRT_COMPOSITOR_SCALE_PERCENTAGE), so the Pimax row writes that instead of a second copy in env_vars.
+fn apply_env_change(config: &mut Config, key: String, value: Option<String>) {
+    if key == "XRT_COMPOSITOR_SCALE_PERCENTAGE" {
+        if let Some(v) = value.as_deref().and_then(|v| v.trim().parse::<u16>().ok()) {
+            config.global_preferences.scale_percentage = v;
+        }
+        config.global_preferences.env_vars.remove(&key);
+        return;
+    }
+    match value {
+        Some(v) => {
+            config.global_preferences.env_vars.insert(key, v);
+        }
+        None => {
+            config.global_preferences.env_vars.remove(&key);
+        }
+    }
+}
