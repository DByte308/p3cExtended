+
+/// Parses "ay,by,cy,ap,bp,cp" as the driver does.
+fn parse_calib(v: &str) -> Option<[f64; 6]> {
+    let n: Vec<f64> = v.split(',').filter_map(|x| x.trim().parse().ok()).collect();
+    <[f64; 6]>::try_from(n).ok().filter(|c| c.iter().all(|x| x.is_finite()))
+}
+
+/// The tool measures gaze with the active correction `old` already applied, so its fit `new` maps corrected
+/// angles to true ones. Both are affine maps on (yaw, pitch); the full correction is new(old(raw)).
+fn compose_calib(new: [f64; 6], old: [f64; 6]) -> [f64; 6] {
+    let [n0, n1, n2, n3, n4, n5] = new;
+    let [o0, o1, o2, o3, o4, o5] = old;
+    [
+        n0 * o0 + n1 * o3,
+        n0 * o1 + n1 * o4,
+        n0 * o2 + n1 * o5 + n2,
+        n3 * o0 + n4 * o3,
+        n3 * o1 + n4 * o4,
+        n3 * o2 + n4 * o5 + n5,
+    ]
 }
 
