+    /// Refresh rate choice. Rates the connected headset does not list in its EDID are greyed out and cannot be
+    /// picked; without a visible headset only "Headset default" can be picked. Re-checked whenever the row is shown.
+    pub fn refresh_rate_row(&self, k: &'static str, choices: &'static [(&'static str, Option<u32>)]) -> adw::ComboRow {
+        const DESC: &str = "72 Hz saves GPU time";
+        let rates: Rc<RefCell<Option<std::collections::BTreeSet<u32>>>> =
+            Rc::new(RefCell::new(crate::headset_edid::headset_rates()));
+        let allowed = {
+            let rates = rates.clone();
+            move |i: usize| match choices.get(i) {
+                Some((_, None)) => true,
+                Some((_, Some(hz))) => rates.borrow().as_ref().is_some_and(|r| r.contains(hz)),
+                None => false,
+            }
+        };
+        let subtitle = {
+            let rates = rates.clone();
+            move || match rates.borrow().as_ref() {
+                Some(r) => format!(
+                    "{DESC}. This headset offers {} Hz",
+                    r.iter().map(u32::to_string).collect::<Vec<_>>().join(", ")
+                ),
+                None => format!("{DESC}. Headset display not detected: only the headset default can be chosen"),
+            }
+        };
+
+        let row = adw::ComboRow::builder()
+            .title("Refresh rate")
+            .subtitle(subtitle())
+            .subtitle_lines(0)
+            .model(&gtk::StringList::new(&choices.iter().map(|(l, _)| *l).collect::<Vec<_>>()))
+            .build();
+        let cur = self.get(k).and_then(|v| v.parse::<u32>().ok());
+        let cur_idx = choices.iter().position(|(_, v)| *v == cur).unwrap_or(0);
+        row.set_selected(cur_idx as u32);
+
+        // Popup entries: label plus check mark, greyed out and not selectable when the headset lacks the rate.
+        let factory = gtk::SignalListItemFactory::new();
+        factory.connect_setup(|_, item| {
+            let item = item.downcast_ref::<gtk::ListItem>().unwrap();
+            let b = gtk::Box::new(gtk::Orientation::Horizontal, 12);
+            b.append(&gtk::Label::builder().xalign(0.0).hexpand(true).build());
+            b.append(&gtk::Image::from_icon_name("object-select-symbolic"));
+            item.set_child(Some(&b));
+        });
+        {
+            let allowed = allowed.clone();
+            let row_w = row.downgrade();
+            factory.connect_bind(move |_, item| {
+                let item = item.downcast_ref::<gtk::ListItem>().unwrap();
+                let (Some(b), Some(s)) = (
+                    item.child().and_downcast::<gtk::Box>(),
+                    item.item().and_downcast::<gtk::StringObject>(),
+                ) else {
+                    return;
+                };
+                let ok = allowed(item.position() as usize);
+                let label = b.first_child().and_downcast::<gtk::Label>().unwrap();
+                label.set_label(&if ok { s.string().to_string() } else { format!("{} (not supported)", s.string()) });
+                b.set_sensitive(ok);
+                item.set_selectable(ok);
+                item.set_activatable(ok);
+                let selected = row_w.upgrade().is_some_and(|r| r.selected() == item.position());
+                b.last_child().unwrap().set_opacity(if selected { 1.0 } else { 0.0 });
+            });
+        }
+        row.set_list_factory(Some(&factory));
+
+        {
+            let c = self.clone();
+            let allowed = allowed.clone();
+            row.connect_selected_notify(move |row| {
+                let i = row.selected() as usize;
+                if !allowed(i) {
+                    // keyboard or a stale list: fall back to the headset default
+                    row.set_selected(0);
+                    return;
+                }
+                c.set(k, choices.get(i).and_then(|(_, v)| *v).map(|v| v.to_string()));
+            });
+        }
+        {
+            let rates = rates.clone();
+            row.connect_map(move |row| {
+                *rates.borrow_mut() = crate::headset_edid::headset_rates();
+                row.set_subtitle(&subtitle());
+                if !allowed(row.selected() as usize) {
+                    row.set_selected(0);
+                }
+            });
+        }
+        row
+    }
+
     /// Spin row for a numeric option; `unset` (shown as that value) removes the var.
     #[allow(clippy::too_many_arguments)]
     pub fn num_row(&self, k: &'static str, title: &str, desc: &str, unset: f64, min: f64, max: f64, step: f64) -> adw::SpinRow {
