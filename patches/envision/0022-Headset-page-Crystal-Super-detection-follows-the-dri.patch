From 63e5e06aba52b86ab21e788b638b1425d58738f1 Mon Sep 17 00:00:00 2001
From: DByte308 <69403407+DByte308@users.noreply.github.com>
Date: Tue, 24 Nov 2026 20:05:08 +0100
Subject: [PATCH 22/22] Headset page: Crystal Super detection follows the
 driver, refreshes live

Match only USB product 0040, the id the driver maps to the Crystal Super;
0046 was never one the driver knows. Re-check the upscaling row every 2 s
while it is shown, so plugging in or unplugging a headset updates it
without leaving the page.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/ui/pimax_common.rs |  5 +++--
 src/ui/pimax_pages.rs  | 27 +++++++++++++++++++++++++--
 2 files changed, 28 insertions(+), 4 deletions(-)

diff --git a/src/ui/pimax_common.rs b/src/ui/pimax_common.rs
index b53a877..bfe19b4 100644
--- a/src/ui/pimax_common.rs
+++ b/src/ui/pimax_common.rs
@@ -88,7 +88,8 @@ pub fn pimax_plugged_in() -> bool {
     })
 }
 
-/// True when a Crystal Super series headset is connected (USB product 0040 or 0046 of the Pimax vendor id).
+/// True when a Crystal Super series headset is connected (USB product 0040 of the Pimax vendor id, the id the
+/// driver maps to the Crystal Super).
 pub fn crystal_super_connected() -> bool {
     let Ok(dir) = std::fs::read_dir("/sys/bus/usb/devices") else {
         return false;
@@ -96,7 +97,7 @@ pub fn crystal_super_connected() -> bool {
     let read = |p: &std::path::Path, f: &str| std::fs::read_to_string(p.join(f)).map(|v| v.trim().to_ascii_lowercase());
     dir.flatten().any(|e| {
         read(&e.path(), "idVendor").is_ok_and(|v| v == PIMAX_USB_VENDOR.to_ascii_lowercase())
-            && read(&e.path(), "idProduct").is_ok_and(|p| p == "0040" || p == "0046")
+            && read(&e.path(), "idProduct").is_ok_and(|p| p == "0040")
     })
 }
 
diff --git a/src/ui/pimax_pages.rs b/src/ui/pimax_pages.rs
index 5d75f2a..284eeb9 100644
--- a/src/ui/pimax_pages.rs
+++ b/src/ui/pimax_pages.rs
@@ -298,14 +298,37 @@ impl SimpleComponent for HeadsetPage {
         display.add(&{
             const DESC: &str = "Upscaling in the headset; the session starts with it off. Applies immediately while the session runs";
             let row = ctx.choice_row("PIMAX_UPSCALE", "Display upscaling", DESC, &[("Off (default)", None), ("On", Some("1"))]);
-            // No effect on the Crystal Super series, and the driver ignores the setting there.
+            // No effect on the Crystal Super series, and the driver ignores the setting there. Re-checked every
+            // 2 s while the row is shown, so plugging in or unplugging a headset updates it.
             let update = |row: &adw::ComboRow| {
                 let sup = super::pimax_common::crystal_super_connected();
                 row.set_sensitive(!sup);
                 row.set_subtitle(if sup { "Not supported by the Crystal Super series" } else { DESC });
             };
             update(&row);
-            row.connect_map(move |r| update(r));
+            let poll: std::rc::Rc<std::cell::RefCell<Option<gtk::glib::SourceId>>> = Default::default();
+            row.connect_map({
+                let poll = poll.clone();
+                move |r| {
+                    update(r);
+                    let weak = r.downgrade();
+                    let id = gtk::glib::timeout_add_seconds_local(2, move || match weak.upgrade() {
+                        Some(r) => {
+                            update(&r);
+                            gtk::glib::ControlFlow::Continue
+                        }
+                        None => gtk::glib::ControlFlow::Break,
+                    });
+                    if let Some(old) = poll.replace(Some(id)) {
+                        old.remove();
+                    }
+                }
+            });
+            row.connect_unmap(move |_| {
+                if let Some(id) = poll.take() {
+                    id.remove();
+                }
+            });
             row
         });
         content.append(&display);
-- 
