+/// Options the driver re-reads while the service runs (from `live_settings_path()`), so no restart is needed.
+pub const LIVE_KEYS: &[&str] =
+    &["PIMAX_IPD_OFFSET_MM", "PIMAX_CANT_SCALE", "PIMAX_EYE_CALIB", "PIMAX_EYE_FLIP", "PIMAX_STICK_DEADZONE"];
+
+pub fn live_settings_path() -> Option<std::path::PathBuf> {
+    std::env::var_os("XDG_RUNTIME_DIR").map(|d| std::path::PathBuf::from(d).join("pimax-p3c/settings.json"))
+}
+
+/// Write the current value (or null = driver default) of every live key for the running driver.
+/// `env` is the environment the service gets (profile over global).
+pub fn write_live_settings(env: &HashMap<String, String>) {
+    let Some(path) = live_settings_path() else { return };
+    let map: serde_json::Map<String, serde_json::Value> = LIVE_KEYS
+        .iter()
+        .map(|k| (k.to_string(), env.get(*k).map(|v| serde_json::Value::String(v.clone())).unwrap_or(serde_json::Value::Null)))
+        .collect();
+    let res = (|| -> std::io::Result<()> {
+        std::fs::create_dir_all(path.parent().unwrap())?;
+        let tmp = path.with_extension("json.tmp");
+        std::fs::write(&tmp, serde_json::to_vec_pretty(&map)?)?;
+        std::fs::rename(&tmp, &path)
+    })();
+    if let Err(e) = res {
+        tracing::warn!("pimax: could not write {}: {e}", path.display());
+    }
+}
