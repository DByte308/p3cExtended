-/// Contents of $XDG_RUNTIME_DIR/pimax-p3c/status.json (written by the driver while the XR service runs).
-#[derive(Debug, Default, Clone, PartialEq, Deserialize)]
-#[serde(default)]
-pub struct PimaxStatus {
-    updated_unix_ms: u64,
-    model: Option<String>,
-    serial: Option<String>,
-    firmware: Option<String>,
-    device_check: Option<String>,
-    refresh_hz: Option<f64>,
-    ipd_mm: Option<f64>,
-    eye_tracking: Option<EyeTrackingStatus>,
-    foveation: Option<bool>,
-    controllers: Option<ControllersStatus>,
-}
-
-fn read_status() -> Option<PimaxStatus> {
-    let dir = std::env::var("XDG_RUNTIME_DIR").ok()?;
-    let data = std::fs::read(format!("{dir}/pimax-p3c/status.json")).ok()?;
-    let st: PimaxStatus = serde_json::from_slice(&data).ok()?;
-    let now = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).ok()?.as_millis() as u64;
-    (now.abs_diff(st.updated_unix_ms) <= STATUS_MAX_AGE_MS).then_some(st)
-}
-
-fn on_off(b: Option<bool>) -> String {
-    match b {
-        Some(true) => "On".into(),
-        Some(false) => "Off".into(),
-        None => "Unknown".into(),
-    }
-}
-
-fn controller_text(c: &Option<ControllerStatus>) -> String {
-    match c {
-        Some(ControllerStatus { connected: Some(true), battery_percent }) => match battery_percent {
-            Some(b) => format!("Connected, battery {b:.0}%"),
-            None => "Connected".into(),
-        },
-        Some(ControllerStatus { connected: Some(false), .. }) => "Not connected".into(),
-        _ => "Unknown".into(),
-    }
-}
-
-impl PimaxStatus {
-    fn rows(&self) -> Vec<(&'static str, String)> {
-        let s = |o: &Option<String>| o.clone().filter(|v| !v.is_empty()).unwrap_or_else(|| "Unknown".into());
-        let et = self.eye_tracking.clone().unwrap_or_default();
-        let et_text = match (et.enabled, et.calibrated) {
-            (Some(false), _) => "Off".to_string(),
-            (Some(true), Some(true)) => "On, calibrated".into(),
-            (Some(true), Some(false)) => "On, not calibrated".into(),
-            (en, _) => on_off(en),
-        };
-        let ctrl = self.controllers.clone().unwrap_or_default();
-        let mut rows = vec![
-            ("Model", s(&self.model)),
-            ("Serial", s(&self.serial)),
-            ("Firmware", s(&self.firmware)),
-        ];
-        if let Some(dc) = self.device_check.as_ref().filter(|v| !v.is_empty()) {
-            rows.push(("Device check", dc.clone()));
-        }
-        rows.extend([
-            ("Refresh rate", self.refresh_hz.map(|v| format!("{v:.0} Hz")).unwrap_or_else(|| "Unknown".into())),
-            ("IPD", self.ipd_mm.map(|v| format!("{v:.1} mm")).unwrap_or_else(|| "Unknown".into())),
-            ("Eye tracking", et_text),
-            ("Foveation", on_off(self.foveation)),
-            ("Left controller", controller_text(&ctrl.left)),
-            ("Right controller", controller_text(&ctrl.right)),
-        ]);
-        rows
-    }
-}
