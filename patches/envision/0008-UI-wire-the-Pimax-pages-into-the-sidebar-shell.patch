-    fn update(&mut self, message: Self::Input, sender: ComponentSender<Self>) {
-        self.reset();
-        match message {
-            PimaxBoxMsg::XRServiceActiveChanged(active) => {
-                self.set_xrservice_active(active);
-                if !active {
-                    self.set_restart_needed(false);
-                }
-            }
-            PimaxBoxMsg::Run(t) => {
-                if self.running.is_some() {
-                    return;
-                }
-                let (cmd, args) = t.command();
-                if !std::path::Path::new(&cmd).exists() {
-                    self.set_success(false);
-                    self.set_status(Some(format!("{cmd} not found; install the pimax-linux tools")));
-                    return;
-                }
-                info!("pimax: running {cmd} {args:?}");
-                self.log.clear();
-                let mut jobs = VecDeque::new();
-                jobs.push_back(WorkerJob::new_cmd(None, cmd, Some(args)));
-                let w = JobWorker::new(jobs, sender.input_sender(), |msg| match msg {
-                    JobWorkerOut::Log(lines) => PimaxBoxMsg::OnLog(lines),
-                    JobWorkerOut::Exit(code) => PimaxBoxMsg::OnExit(code),
-                });
-                w.start();
-                self.worker = Some(w);
-                self.set_running(Some(t));
-                self.set_success(true);
-                self.set_status(Some(format!("{} running in the headset…", t.label())));
-            }
-            PimaxBoxMsg::Stop => {
-                if let Some(w) = self.worker.as_ref() {
-                    w.stop();
-                }
-            }
-            PimaxBoxMsg::OnLog(lines) => self.log.extend(lines.into_iter().map(|l| l.trim_end().to_string())),
-            PimaxBoxMsg::OnExit(code) => {
-                let tool = self.running.take();
-                self.set_running(None);
-                self.worker = None;
-                match tool {
-                    Some(PimaxTool::Calibrate) => self.finish_calibration(code, &sender),
-                    Some(t) => {
-                        self.set_success(code == 0);
-                        self.set_status(Some(if code == 0 {
-                            format!("{} finished", t.label())
-                        } else {
-                            format!("{} exited with code {code}", t.label())
-                        }));
-                    }
-                    None => {}
-                }
-            }
-            PimaxBoxMsg::PollPresence => self.set_visible(pimax_plugged_in()),
-            PimaxBoxMsg::PollStatus => {
-                let st = read_status();
-                if self.info != st {
-                    self.set_info(st);
-                }
-            }
-            PimaxBoxMsg::Restart => {
-                self.set_restart_needed(false);
-                let _ = sender.output(PimaxBoxOutMsg::RestartXRService);
-            }
-        }
-    }
