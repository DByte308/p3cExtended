-const PIMAX_USB_VENDOR: &str = "34a4";
-/// The status file counts as fresh when written within this many ms.
-const STATUS_MAX_AGE_MS: u64 = 5000;
-
-/// True when any USB device has the Pimax vendor id.
-fn pimax_plugged_in() -> bool {
-    let Ok(dir) = std::fs::read_dir("/sys/bus/usb/devices") else {
-        return false;
-    };
-    dir.flatten().any(|e| {
-        std::fs::read_to_string(e.path().join("idVendor")).is_ok_and(|v| v.trim().eq_ignore_ascii_case(PIMAX_USB_VENDOR))
-    })
-}
