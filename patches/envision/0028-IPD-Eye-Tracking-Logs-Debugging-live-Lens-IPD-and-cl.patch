 src/ui/debug_view.rs   |  71 +++++++++++++++++++++++++++
 src/ui/pimax_common.rs |   1 +
 src/ui/pimax_eye.rs    |  80 +++++++++++++++++++++++++-----
 src/ui/pimax_pages.rs  | 109 +++++++----------------------------------
 src/ui/shell.rs        |   4 +-
 6 files changed, 171 insertions(+), 105 deletions(-)

