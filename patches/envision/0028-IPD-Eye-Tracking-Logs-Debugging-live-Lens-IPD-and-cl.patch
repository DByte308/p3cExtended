@@ -630,6 +669,36 @@ impl AsyncComponent for DebugView {
                     .output(Self::Output::ProfilesEnabledChanged(enabled))
                     .expect(SENDER_IO_ERR_MSG);
             }
+            Self::Input::SessionLogToggled(on) => {
+                if on != self.session_log_enabled {
+                    self.set_session_log_enabled(on);
+                    sender
+                        .output(Self::Output::SetEnvVar(
+                            crate::session_log::ENABLE_KEY.to_string(),
+                            on.then(|| "1".to_string()),
+                        ))
+                        .expect(SENDER_IO_ERR_MSG);
+                }
+            }
+            Self::Input::MirrorDumpToggled(on) => {
+                if on != self.mirror_dump_enabled {
+                    self.set_mirror_dump_enabled(on);
+                    let dir = gtk::glib::home_dir()
+                        .join(".cache/pimax-linux/view")
+                        .to_string_lossy()
+                        .to_string();
+                    sender
+                        .output(Self::Output::SetEnvVar(
+                            "XRT_MIRROR_DUMP".to_string(),
+                            on.then_some(dir),
+                        ))
+                        .expect(SENDER_IO_ERR_MSG);
+                }
+            }
+            Self::Input::ReloadEnv(env) => {
+                self.set_session_log_enabled(crate::session_log::enabled(&env));
+                self.set_mirror_dump_enabled(env.contains_key("XRT_MIRROR_DUMP"));
+            }
         }
     }
 
