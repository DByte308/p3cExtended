@@ -0,0 +1,76 @@
+//! Keeps the XR service's output of every session in a file, so a problem seen in a normal session can be looked
+//! at afterwards (the debug view only holds it until the next start). One file per session in
+//! `~/.cache/pimax-linux/sessions/`, named by the start time; the newest `KEEP` are kept. Off by default, switched
+//! on in Headset → Debugging.
+
+use std::fs::{self, File};
+use std::io::{BufWriter, Write};
+use std::path::PathBuf;
+
+const KEEP: usize = 10;
+
+/// Setting (stored with the other headset settings) that turns the session log on; off while unset.
+pub const ENABLE_KEY: &str = "PIMAX_SESSION_LOG";
+
+/// On for any value that is not false-like, the same rule the switch uses to show it.
+pub fn enabled(env: &std::collections::HashMap<String, String>) -> bool {
+    env.get(ENABLE_KEY).is_some_and(|v| {
+        !matches!(v.to_ascii_lowercase().as_str(), "0" | "false" | "f" | "off" | "no" | "n")
+    })
+}
+
+pub struct SessionLog {
+    out: BufWriter<File>,
+    pub path: PathBuf,
+}
+
+/// None without an absolute cache directory (never a path relative to wherever Envision was started).
+fn dir() -> Option<PathBuf> {
+    let cache = std::env::var_os("XDG_CACHE_HOME")
+        .filter(|v| !v.is_empty())
+        .map(PathBuf::from)
+        .or_else(|| std::env::var_os("HOME").filter(|v| !v.is_empty()).map(|h| PathBuf::from(h).join(".cache")))?;
+    cache.is_absolute().then(|| cache.join("pimax-linux/sessions"))
+}
+
+impl SessionLog {
+    /// A new file for a session starting now, after removing the oldest ones. None if it cannot be created.
+    pub fn start() -> Option<Self> {
+        let dir = dir()?;
+        fs::create_dir_all(&dir).ok()?;
+        let mut old: Vec<PathBuf> = fs::read_dir(&dir)
+            .ok()?
+            .flatten()
+            .map(|e| e.path())
+            .filter(|p| p.extension().is_some_and(|x| x == "log"))
+            .collect();
+        old.sort();
+        while old.len() >= KEEP {
+            let _ = fs::remove_file(old.remove(0));
+        }
+        let name = relm4::gtk::glib::DateTime::now_local()
+            .and_then(|t| t.format("%Y-%m-%d_%H-%M-%S"))
+            .map(|s| s.to_string())
+            .unwrap_or_else(|_| "session".into());
+        // A restart within the same second gets its own file instead of truncating the one before.
+        for n in 0..100 {
+            let path = dir.join(if n == 0 { format!("{name}.log") } else { format!("{name}_{n}.log") });
+            match fs::OpenOptions::new().write(true).create_new(true).open(&path) {
+                Ok(f) => return Some(Self { out: BufWriter::new(f), path }),
+                Err(e) if e.kind() == std::io::ErrorKind::AlreadyExists => continue,
+                Err(_) => return None,
+            }
+        }
+        None
+    }
+
+    pub fn append(&mut self, rows: &[String]) {
+        for r in rows {
+            let _ = self.out.write_all(r.as_bytes());
+            if !r.ends_with('\n') {
+                let _ = self.out.write_all(b"\n");
+            }
+        }
+        let _ = self.out.flush();
+    }
+}
