@@ -370,7 +370,6 @@ impl AsyncComponent for PreferencesWindow {
 
         let widgets = view_output!();
 
-        widgets.win.add(&super::pimax_prefs::pimax_page(model.config.clone()));
         model.win = Some(widgets.win.clone());
         model.plugins_grp = Some(widgets.plugins_grp.clone());
 
