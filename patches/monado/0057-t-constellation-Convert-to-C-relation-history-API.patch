From 66207ead1e9927c24ecd9ae65998276689a251ef Mon Sep 17 00:00:00 2001
From: Beyley Cardellio <ep1cm1n10n123@gmail.com>
Date: Tue, 10 Nov 2026 19:25:32 -0800
Subject: [PATCH 57/63] t/constellation: Convert to C++ relation history API

Signed-off-by: Beyley Cardellio <ep1cm1n10n123@gmail.com>
Part-of: <https://gitlab.freedesktop.org/monado/monado/-/merge_requests/3104>
---
 .../constellation/optimizer/sensor_fusion.cpp | 30 +++++++++++--------
 .../constellation/optimizer/sensor_fusion.hpp |  4 +--
 2 files changed, 19 insertions(+), 15 deletions(-)

diff --git a/src/xrt/tracking/constellation/optimizer/sensor_fusion.cpp b/src/xrt/tracking/constellation/optimizer/sensor_fusion.cpp
index b6b680658..6479f60f6 100644
--- a/src/xrt/tracking/constellation/optimizer/sensor_fusion.cpp
+++ b/src/xrt/tracking/constellation/optimizer/sensor_fusion.cpp
@@ -1261,7 +1261,7 @@ static void
 integrateToTimestampHistory(const xrt_vec3_f64 &world_gravity,
                             DeviceSolveState &inout_solve,
                             const std::span<const xrt_imu_sample> imu_samples,
-                            m_relation_history *relation_history,
+                            RelationHistory &relation_history,
                             timepoint_ns optical_ns)
 {
 	const double max_reckon_s = maxDeadReckonSeconds();
@@ -1332,7 +1332,7 @@ integrateToTimestampHistory(const xrt_vec3_f64 &world_gravity,
 			relation.linear_velocity = XRT_VEC3_ZERO;
 		}
 
-		m_relation_history_push_or_update(relation_history, &relation, pose_ns);
+		relation_history.pushOrUpdate({relation, pose_ns}, true);
 	}
 
 	map_vec3(inout_solve.Tcv_world_device.position) = T_world_device.cast<float>();
@@ -2477,24 +2477,21 @@ struct SensorFusionProblem
  *
  */
 
-Device::Device(t_constellation_device_id_t id, const t_constellation_tracker_led_model *led_model)
+Device::Device(t_constellation_device_id_t id,
+               const t_constellation_tracker_led_model *led_model)
     : id(id),                          //
       led_model(led_model),            //
       latest_solve(std::nullopt),      //
       latest_imu_reckon(std::nullopt), //
+      imu_relation_history(),          //
       stored_imu_calibration(),        //
       imu_write_count(0),              //
       imu_samples()                    //
 {
-	m_relation_history_create(&this->relation_history);
-
 	this->resetLocked();
 }
 
-Device::~Device()
-{
-	m_relation_history_destroy(&this->relation_history);
-}
+Device::~Device() = default;
 
 const DeviceImuCalibration &
 Device::getLatestImuCalibration() const
@@ -2509,7 +2506,7 @@ Device::getLatestImuCalibration() const
 void
 Device::resetLocked()
 {
-	m_relation_history_clear(this->relation_history);
+	this->imu_relation_history.clear();
 
 	this->latest_solve = std::nullopt;
 	this->latest_imu_reckon = std::nullopt;
@@ -3056,8 +3053,15 @@ void
 SensorFusion::getTrackedPose(timepoint_ns requested_time_ns, xrt_space_relation &out_relation)
 {
 	out_relation = XRT_SPACE_RELATION_ZERO;
-	m_relation_history_get(this->device.relation_history, requested_time_ns, &out_relation);
-	SF_TRACE(this, "Used relation history for pose at ts %" PRIi64, requested_time_ns);
+
+	RelationHistoryEntry entry{};
+	auto result = this->device.imu_relation_history.get(requested_time_ns, entry);
+	if (result != M_RELATION_HISTORY_RESULT_INVALID) {
+		out_relation = entry.relation;
+	}
+
+	SF_TRACE(this, "Used relation history for pose at ts %" PRIi64 ", got result %d", requested_time_ns,
+	         static_cast<int>(result));
 
 	// Convert to OpenXR coordinate space before outputting
 	math_pose_convert_from_opencv(&out_relation.pose, &out_relation.pose);
@@ -3256,7 +3260,7 @@ SensorFusion::reckonToLatestImu(DeviceSolveState &inout_solve)
 	integrateToTimestampHistory(this->snapshot.world_gravity,                                     //
 	                            inout_solve,                                                      //
 	                            std::span<const xrt_imu_sample>(samples_buf.data(), num_samples), //
-	                            device.relation_history,                                          //
+	                            device.imu_relation_history,                                      //
 	                            device.latest_solve ? device.latest_solve->time_ns : inout_solve.time_ns);
 
 	SF_TRACE(this, "Filled relation history for device %d from %" PRIi64 " to %" PRIi64, device.id, start_ns,
diff --git a/src/xrt/tracking/constellation/optimizer/sensor_fusion.hpp b/src/xrt/tracking/constellation/optimizer/sensor_fusion.hpp
index 6df5cbd39..867d23051 100644
--- a/src/xrt/tracking/constellation/optimizer/sensor_fusion.hpp
+++ b/src/xrt/tracking/constellation/optimizer/sensor_fusion.hpp
@@ -17,7 +17,7 @@
 
 #include "constellation/t_constellation_tracker.h"
 
-#include "math/m_relation_history.h"
+#include "math/m_relation_history.hpp"
 
 #include "imu_preintegration.hpp"
 
@@ -265,7 +265,7 @@ public: // Fields
 	std::optional<DeviceSolveState> latest_imu_reckon;
 
 	//! The relation history of the device, used as a fast way to retrieve the latest dead-reckoned poses.
-	m_relation_history *relation_history;
+	RelationHistory imu_relation_history;
 
 	//! Pre-calibrated accelerometer bias, in meters per second squared.
 	DeviceImuCalibration stored_imu_calibration;
-- 
