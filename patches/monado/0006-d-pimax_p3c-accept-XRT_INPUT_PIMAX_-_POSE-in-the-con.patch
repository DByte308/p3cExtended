diff --git a/src/xrt/drivers/pimax_p3c/src/device/session/status.rs b/src/xrt/drivers/pimax_p3c/src/device/session/status.rs
index 54c6551cd..6f7600b06 100644
--- a/src/xrt/drivers/pimax_p3c/src/device/session/status.rs
+++ b/src/xrt/drivers/pimax_p3c/src/device/session/status.rs
@@ -12,7 +12,47 @@ use pimax_protocol::device::PimaxSubDevice;
 use pimax_protocol::status::imu::ImuSample;
 use pimax_protocol::status::stream::StatusStream;
 use std::sync::Arc;
-use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+
+/// Per-hand controller pipeline counters, logged once a second from the HMD stream (which always runs).
+#[derive(Default)]
+pub struct ControllerDiag {
+    pub reports: AtomicU64,
+    pub no_clock: AtomicU64,
+    pub imu_pushed: AtomicU64,
+    pub pose_queries: AtomicU64,
+    pub pose_valid: AtomicU64,
+}
+
+pub static CONTROLLER_DIAG: [ControllerDiag; 2] = [const { ControllerDiag::new() }, const { ControllerDiag::new() }];
+static DIAG_LAST_NS: AtomicU64 = AtomicU64::new(0);
+
+impl ControllerDiag {
+    const fn new() -> Self {
+        Self {
+            reports: AtomicU64::new(0),
+            no_clock: AtomicU64::new(0),
+            imu_pushed: AtomicU64::new(0),
+            pose_queries: AtomicU64::new(0),
+            pose_valid: AtomicU64::new(0),
+        }
+    }
+}
+
+fn log_controller_diag(now: i64) {
+    let last = DIAG_LAST_NS.load(Ordering::Relaxed);
+    if now - (last as i64) < 1_000_000_000 {
+        return;
+    }
+    DIAG_LAST_NS.store(now as u64, Ordering::Relaxed);
+    let take = |a: &AtomicU64| a.swap(0, Ordering::Relaxed);
+    let [l, r] = &CONTROLLER_DIAG;
+    info!(
+        "controllers 1 s: L reports {} no_clock {} imu {} pose {}/{} | R reports {} no_clock {} imu {} pose {}/{}",
+        take(&l.reports), take(&l.no_clock), take(&l.imu_pushed), take(&l.pose_valid), take(&l.pose_queries),
+        take(&r.reports), take(&r.no_clock), take(&r.imu_pushed), take(&r.pose_valid), take(&r.pose_queries),
+    );
+}
 use std::thread;
 use std::thread::JoinHandle;
 
@@ -67,6 +107,7 @@ impl OnReport for HmdStatus {
         let device_ns = self.imu[0].timestamp_us as i64 * 1000;
         let host_ns = tracking.clock.lock().unwrap().observe(device_ns, now_ns());
         trace!("received HMD status: {device_ns} => {host_ns}");
+        log_controller_diag(now_ns());
 
         if tracking.slam_frames_started.load(Ordering::Relaxed)
             && let Some(slam) = tracking.slam.get()
@@ -101,6 +142,8 @@ impl OnReport for ControllerStatus {
             PimaxSubDevice::ControllerRight => Hand::Right,
             _ => return,
         };
+        let diag = &CONTROLLER_DIAG[hand as usize];
+        diag.reports.fetch_add(1, Ordering::Relaxed);
         let to_host = |sample: &ImuSample| {
             tracking
                 .clock
@@ -109,6 +152,7 @@ impl OnReport for ControllerStatus {
                 .to_host(sample.timestamp_us as i64 * 1000)
         };
         let Some(host_ns) = to_host(&self.imu[0]) else {
+            diag.no_clock.fetch_add(1, Ordering::Relaxed);
             return;
         };
 
@@ -123,6 +167,7 @@ impl OnReport for ControllerStatus {
                     continue;
                 }
                 last_ns = sample_ns;
+                diag.imu_pushed.fetch_add(1, Ordering::Relaxed);
                 constellation.push_controller_imu(
                     hand,
                     sample_ns,
