From 21557cc8b7cf1d407275fed2414954029899d0fa Mon Sep 17 00:00:00 2001
From: DByte308 <69403407+DByte308@users.noreply.github.com>
Date: Mon, 23 Nov 2026 18:14:30 +0100
Subject: [PATCH 06/28] d/pimax_p3c: accept XRT_INPUT_PIMAX_*_POSE in the
 controller get_tracked_pose

a792ef0a9 renamed the declared pose inputs to XRT_INPUT_PIMAX_GRIP/AIM_POSE but
get_tracked_pose still only accepted the TOUCH names, so every pose request
returned XRT_ERROR_INPUT_UNSUPPORTED and no app ever got a controller pose.
Verified: both controllers valid+tracked via oculus/touch_controller rebinding.

Also: per-hand controller counters (reports, no_clock, imu pushed, valid/queried
poses) logged once a second.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../pimax_p3c/src/device/controller/mod.rs    | 16 +++++--
 .../pimax_p3c/src/device/session/mod.rs       |  2 +-
 .../pimax_p3c/src/device/session/status.rs    | 47 ++++++++++++++++++-
 3 files changed, 60 insertions(+), 5 deletions(-)

diff --git a/src/xrt/drivers/pimax_p3c/src/device/controller/mod.rs b/src/xrt/drivers/pimax_p3c/src/device/controller/mod.rs
index 696f80a1b..c5dde844f 100644
--- a/src/xrt/drivers/pimax_p3c/src/device/controller/mod.rs
+++ b/src/xrt/drivers/pimax_p3c/src/device/controller/mod.rs
@@ -114,12 +114,19 @@ unsafe extern "C" fn get_tracked_pose(
     at_ns: i64,
     out: *mut xrt_space_relation,
 ) -> xrt_result_t {
-    if name != xrt_input_name::XRT_INPUT_TOUCH_GRIP_POSE
-        && name != xrt_input_name::XRT_INPUT_TOUCH_AIM_POSE
-    {
+    // The device declares XRT_INPUT_PIMAX_*_POSE (a792ef0a9); the Touch names stay accepted for older clients.
+    if !matches!(
+        name,
+        xrt_input_name::XRT_INPUT_PIMAX_GRIP_POSE
+            | xrt_input_name::XRT_INPUT_PIMAX_AIM_POSE
+            | xrt_input_name::XRT_INPUT_TOUCH_GRIP_POSE
+            | xrt_input_name::XRT_INPUT_TOUCH_AIM_POSE
+    ) {
         return xrt_result::XRT_ERROR_INPUT_UNSUPPORTED;
     }
     let me = unsafe { &*(xdev as *const PimaxController) };
+    let diag = &crate::device::session::status::CONTROLLER_DIAG[me.hand as usize];
+    diag.pose_queries.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
     // Nothing valid until the tracker has seen the controller; apps show it hidden.
     let relation = me
         .tracking
@@ -127,6 +134,9 @@ unsafe extern "C" fn get_tracked_pose(
         .get()
         .and_then(|c| c.get_pose(me.hand, at_ns))
         .unwrap_or_default();
+    if relation.relation_flags.0 != 0 {
+        diag.pose_valid.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+    }
     unsafe { *out = relation };
     xrt_result::XRT_SUCCESS
 }
