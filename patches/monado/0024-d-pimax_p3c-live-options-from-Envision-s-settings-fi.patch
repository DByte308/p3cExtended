+//! Options that can change while the service runs.
+//!
+//! Envision writes `$XDG_RUNTIME_DIR/pimax-p3c/settings.json` (`{"NAME": "value" | null}`) when one of these options
+//! changes. A file older than this driver instance is ignored, so a stale file from an earlier session never
+//! overrides the environment the service was started with. A key in the file wins over the environment; `null`
+//! means "unset" (driver default). Keys not in the file come from the environment.
+
+use std::collections::HashMap;
+use std::sync::{LazyLock, Mutex, OnceLock};
+use std::time::{Duration, Instant, SystemTime};
+
+const CHECK_EVERY: Duration = Duration::from_millis(250);
+
+struct State {
+    last_check: Option<Instant>,
+    mtime: Option<SystemTime>,
+    map: HashMap<String, Option<String>>,
+    generation: u64,
+}
+
+static STATE: LazyLock<Mutex<State>> =
+    LazyLock::new(|| Mutex::new(State { last_check: None, mtime: None, map: HashMap::new(), generation: 0 }));
+
+fn started() -> SystemTime {
+    static T: OnceLock<SystemTime> = OnceLock::new();
+    *T.get_or_init(SystemTime::now)
+}
+
+/// Call once at driver start-up: files written before this moment are ignored.
+pub fn init() {
+    started();
+}
+
+fn path() -> Option<std::path::PathBuf> {
+    std::env::var_os("XDG_RUNTIME_DIR")
+        .filter(|d| !d.is_empty())
+        .map(|d| std::path::PathBuf::from(d).join("pimax-p3c/settings.json"))
+}
+
+fn refresh(st: &mut State) {
+    let now = Instant::now();
+    if st.last_check.is_some_and(|t| now.duration_since(t) < CHECK_EVERY) {
+        return;
+    }
+    st.last_check = Some(now);
+    let Some(p) = path() else { return };
+    let Ok(mtime) = std::fs::metadata(&p).and_then(|m| m.modified()) else { return };
+    if mtime < started() || st.mtime == Some(mtime) {
+        return;
+    }
+    st.mtime = Some(mtime);
+    let parsed: Option<HashMap<String, Option<String>>> =
+        std::fs::read(&p).ok().and_then(|b| serde_json::from_slice(&b).ok());
+    match parsed {
+        Some(map) => {
+            if map != st.map {
+                info!("live settings: {map:?}");
+                st.map = map;
+                st.generation += 1;
+            }
+        }
+        None => warn!("live settings: could not parse {}", p.display()),
+    }
+}
+
+/// Bumped every time the live values change; lets callers cache parsed values.
+pub fn generation() -> u64 {
+    let mut st = STATE.lock().unwrap();
+    refresh(&mut st);
+    st.generation
+}
+
+/// Current value of `name`: the live file if it has the key, else the environment.
+pub fn get_str(name: &str) -> Option<String> {
+    let mut st = STATE.lock().unwrap();
+    refresh(&mut st);
+    match st.map.get(name) {
+        Some(v) => v.clone().filter(|v| !v.is_empty()),
+        None => crate::util::option_str(name),
+    }
+}
+
+/// Integer option (like debug_get_num_option: unparsable = default).
+pub fn get_num(name: &str, default: i64) -> i64 {
+    get_str(name).and_then(|v| v.trim().parse::<f64>().ok()).map(|v| v as i64).unwrap_or(default)
+}
