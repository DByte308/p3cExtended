 use pimax_protocol::{CommandDevice, ControllerStatusStream, HmdStatusStream};
 
@@ -33,29 +31,31 @@ fn default_refresh_hz(model: PimaxP3CHmdDisplay) -> u8 {
         | PimaxP3CHmdDisplay::DreamAir => 90,
     }
 }
+static HEADSET_SERIAL: OnceLock<String> = OnceLock::new();
+
+/// The connected headset's serial, set once at bring-up before the rate is resolved.
+pub(super) fn set_headset_serial(serial: &str) {
+    let _ = HEADSET_SERIAL.set(serial.to_string());
+}
+
 /// The refresh rate sent to the headset. A requested rate (PIMAX_REFRESH_HZ) is only used if the headset's own
 /// display lists it in its EDID: the rate goes to the headset unchecked, and a rate the panel cannot drive must
-/// never reach it. Without a readable headset EDID only the model default is used. Resolved once per process,
-/// first right before the rate is sent (after the headset's video work mode is set, when its display is up).
+/// never reach it. The display only comes up after the rate is sent, so the EDID stored in an earlier session is
+/// used (see `edid`); without one only the model default is used. Resolved once per process.
 pub fn refresh_hz(model: PimaxP3CHmdDisplay) -> u8 {
     static RATE: OnceLock<u8> = OnceLock::new();
     *RATE.get_or_init(|| {
         let default = default_refresh_hz(model);
         let requested = option_num(REFRESH_HZ_ENV, 0);
-        // The headset's display may still be coming up right after power-on.
-        let mut rates = edid::headset_rates();
-        for _ in 0..10 {
-            if rates.is_some() {
-                break;
-            }
-            sleep(Duration::from_millis(300));
-            rates = edid::headset_rates();
-        }
+        let rates = HEADSET_SERIAL.get().and_then(|s| edid::headset_rates(s));
         match &rates {
-            Some(r) => info!("headset display modes: {r:?} Hz"),
-            None => warn!("no headset EDID found; refresh rate stays at the model default {default} Hz"),
+            Some((r, from)) => info!("headset display modes from {from}: {r:?} Hz"),
+            None => warn!(
+                "no headset EDID known yet (it is stored once the display is up); refresh rate stays at the model \
+                 default {default} Hz for this session"
+            ),
         }
-        let Some(rates) = rates else { return default };
+        let Some((rates, _)) = rates else { return default };
         let listed = |hz: i64| u32::try_from(hz).is_ok_and(|hz| rates.contains(&hz));
         if requested > 0 && i64::from(default) != requested {
             if let (true, Ok(hz)) = (listed(requested), u8::try_from(requested)) {
diff --git a/src/xrt/drivers/pimax_p3c/src/device/session/video.rs b/src/xrt/drivers/pimax_p3c/src/device/session/video.rs
index 8aadccc1d..cdc826236 100644
--- a/src/xrt/drivers/pimax_p3c/src/device/session/video.rs
+++ b/src/xrt/drivers/pimax_p3c/src/device/session/video.rs
@@ -25,17 +25,18 @@ fn gpu_type() -> GpuType {
 }
 
 /// Starts video and returns the refresh rate sent to the headset.
-pub(super) fn start_video(cmd: &CommandDevice, model: PimaxP3CHmdDisplay) -> Result<u8, Error> {
+pub(super) fn start_video(cmd: &CommandDevice, model: PimaxP3CHmdDisplay, serial: &str) -> Result<u8, Error> {
     cmd.query(&CmdVideoCtrl::SetWorkMode(gpu_type()))?;
     match cmd.query(&CmdGetVideoCtrlInfo) {
         Ok(payload) => debug!("GetVideoCtrlInfo -> {payload:02X?}"),
         Err(e) => warn!("GetVideoCtrlInfo: {e}"),
     }
     sleep(Duration::from_secs(6));
-    // Resolved here, not earlier: the headset display (and its EDID) may only be up after the work mode is set.
     let rate_hz = super::refresh_hz(model);
     cmd.query(&CmdVideoCtrl::SetRate(rate_hz))?;
     cmd.query(&CmdVideoCtrl::Start)?;
+    // The headset display comes up about a second after this; keep its EDID for the next session's rate.
+    super::edid::store_when_up(serial.to_string(), rate_hz);
     Ok(rate_hz)
 }
 
