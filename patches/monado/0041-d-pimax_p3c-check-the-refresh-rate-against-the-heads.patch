         Err(e) => {
             error!("video bring-up failed: {e}");
diff --git a/src/xrt/drivers/pimax_p3c/src/device/session/edid.rs b/src/xrt/drivers/pimax_p3c/src/device/session/edid.rs
index e94c3479b..8115549cc 100644
--- a/src/xrt/drivers/pimax_p3c/src/device/session/edid.rs
+++ b/src/xrt/drivers/pimax_p3c/src/device/session/edid.rs
@@ -6,9 +6,16 @@
 //!
 //! Parsed from the public VESA layouts: detailed timing descriptors in the base block and in CTA-861 extension
 //! blocks, and DisplayID type I (1.x) / type VII (2.x) timings in DisplayID extension blocks.
+//!
+//! The headset's display only comes up after the rate is sent and video is started, so its EDID can not be read
+//! in time for the rate of the same session. Once it is up, the EDID is stored per headset serial in the driver's
+//! config directory (`display/<serial>.edid`), and later sessions check the requested rate against that copy.
 
+use crate::config;
 use std::collections::BTreeSet;
 use std::fs;
+use std::thread;
+use std::time::Duration;
 
 /// PnP manufacturer id of the headset display.
 const HEADSET_MANUFACTURER: &str = "PVR";
@@ -100,16 +107,60 @@ pub fn edid_rates(edid: &[u8]) -> BTreeSet<u32> {
     out
 }
 
-/// Refresh rates of the connected headset display, or None if no headset EDID is visible.
-pub fn headset_rates() -> Option<BTreeSet<u32>> {
-    let mut found: Option<BTreeSet<u32>> = None;
-    for entry in fs::read_dir("/sys/class/drm").ok()?.flatten() {
-        let Ok(edid) = fs::read(entry.path().join("edid")) else { continue };
-        if manufacturer(&edid).as_deref() == Some(HEADSET_MANUFACTURER) {
-            found.get_or_insert_with(BTreeSet::new).extend(edid_rates(&edid));
+/// EDID of the headset display as the kernel shows it, if that display is up.
+fn live_edid() -> Option<Vec<u8>> {
+    fs::read_dir("/sys/class/drm").ok()?.flatten().find_map(|entry| {
+        let edid = fs::read(entry.path().join("edid")).ok()?;
+        (manufacturer(&edid).as_deref() == Some(HEADSET_MANUFACTURER) && !edid_rates(&edid).is_empty()).then_some(edid)
+    })
+}
+
+fn stored_file(serial: &str) -> String {
+    format!("display/{serial}.edid")
+}
+
+/// Refresh rates of this headset's display: from the live EDID if the display is up, else from the copy stored in
+/// an earlier session. The second value says which.
+pub fn headset_rates(serial: &str) -> Option<(BTreeSet<u32>, &'static str)> {
+    if let Some(edid) = live_edid() {
+        return Some((edid_rates(&edid), "its display"));
+    }
+    let edid = fs::read(config::path(stored_file(serial)).ok()?).ok()?;
+    if manufacturer(&edid).as_deref() != Some(HEADSET_MANUFACTURER) {
+        return None;
+    }
+    let rates = edid_rates(&edid);
+    (!rates.is_empty()).then_some((rates, "the copy stored in an earlier session"))
+}
+
+/// After video has started: wait for the headset display, store its EDID for later sessions, and check the rate
+/// this session was started with against it.
+pub fn store_when_up(serial: String, sent_hz: u8) {
+    let spawned = thread::Builder::new().name("pimax-edid".into()).spawn(move || {
+        for _ in 0..60 {
+            let Some(edid) = live_edid() else {
+                thread::sleep(Duration::from_millis(500));
+                continue;
+            };
+            let rates = edid_rates(&edid);
+            info!("headset display modes: {rates:?} Hz");
+            if !rates.contains(&u32::from(sent_hz)) {
+                warn!("the headset display does not list the {sent_hz} Hz this session was started with");
+            }
+            let file = stored_file(&serial);
+            let unchanged = config::path(&file).ok().and_then(|p| fs::read(p).ok()).is_some_and(|old| old == edid);
+            if !unchanged {
+                if let Err(e) = config::write(&file, &edid) {
+                    warn!("could not store the headset EDID: {e}");
+                }
+            }
+            return;
         }
+        warn!("the headset display did not come up within 30 s; its refresh rates stay unknown");
+    });
+    if let Err(e) = spawned {
+        warn!("headset EDID: no thread: {e}");
     }
-    found.filter(|r| !r.is_empty())
 }
 
