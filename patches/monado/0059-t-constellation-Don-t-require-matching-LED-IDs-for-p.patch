From d1fe1183c04cc6c65191bedab0882d85e0479fed Mon Sep 17 00:00:00 2001
From: Beyley Cardellio <ep1cm1n10n123@gmail.com>
Date: Tue, 3 Nov 2026 18:58:36 -0800
Subject: [PATCH 59/63] t/constellation: Don't require matching LED IDs for
 priors

Signed-off-by: Beyley Cardellio <ep1cm1n10n123@gmail.com>
Part-of: <https://gitlab.freedesktop.org/monado/monado/-/merge_requests/3117>
---
 .../constellation/t_constellation_tracker.cpp        | 12 +++++++++---
 .../t_constellation_tracker_internal.hpp             |  1 +
 2 files changed, 10 insertions(+), 3 deletions(-)

diff --git a/src/xrt/tracking/constellation/t_constellation_tracker.cpp b/src/xrt/tracking/constellation/t_constellation_tracker.cpp
index 1b140c4f7..2db0b1d9b 100644
--- a/src/xrt/tracking/constellation/t_constellation_tracker.cpp
+++ b/src/xrt/tracking/constellation/t_constellation_tracker.cpp
@@ -432,6 +432,7 @@ bool
 Camera::tryDevicePose(Device *device,
                       CameraSample &sample,
                       DeviceState &device_state,
+                      bool need_matching_ids,
                       const std::optional<xrt_space_relation> &Tcv_cam_device_prior,
                       const xrt_pose &Tcv_cam_device_candidate)
 {
@@ -468,7 +469,10 @@ Camera::tryDevicePose(Device *device,
 		return false;
 	}
 
-	if (POSE_HAS_FLAGS(&score, POSE_MATCH_GOOD | POSE_MATCH_LED_IDS)) {
+	bool was_good = POSE_HAS_FLAGS(&score, POSE_MATCH_GOOD | (need_matching_ids ? POSE_MATCH_LED_IDS : 0));
+	bool was_strong = POSE_HAS_FLAGS(&score, POSE_MATCH_STRONG);
+
+	if (was_good || was_strong) {
 		return this->pushPose(        //
 		    sample,                   //
 		    device_state,             //
@@ -897,6 +901,7 @@ Camera::processSampleFast(CameraSample &sample)
 		    this->tryDevicePose(device,             //
 		                        sample,             //
 		                        device_state,       //
+		                        false,              // need_matching_ids
 		                        std::nullopt,       //
 		                        Tcv_cam_device_predicted.value().pose)) {
 			CT_DEBUG(tracker, "Fast processing for device %d succeeded with predicted pose", device->id);
@@ -936,6 +941,7 @@ Camera::processSampleFast(CameraSample &sample)
 		    this->tryDevicePose(device,                   //
 		                        sample,                   //
 		                        device_state,             //
+		                        true,                     // need_matching_ids
 		                        Tcv_cam_device_predicted, //
 		                        Tcv_cam_device_last_known.value())) {
 			CT_DEBUG(tracker, "Fast processing for device %d succeeded with last known pose", device->id);
@@ -1296,6 +1302,8 @@ Camera::pushPose(CameraSample &camera_sample,
 			         "blobs failed",
 			         0, 0, device->id, camera_sample.blob_count);
 		} else {
+			Tcv_cam_device = Tcv_cam_device_optimized;
+
 			CT_DEBUG(tracker,
 			         "Camera %d (group %d) RANSAC-PnP refinement for device %d from %u "
 			         "blobs. Produced pose %f,%f,%f,%f pos %f,%f,%f",
@@ -1304,8 +1312,6 @@ Camera::pushPose(CameraSample &camera_sample,
 			         Tcv_cam_device.orientation.w, Tcv_cam_device.position.x, Tcv_cam_device.position.y,
 			         Tcv_cam_device.position.z);
 
-			Tcv_cam_device = Tcv_cam_device_optimized;
-
 			// Now that we've optimized the pose, we gotta update the match info
 			pose_metrics_match_pose_to_blobs(&Tcv_cam_device, camera_sample.blobs, camera_sample.blob_count,
 			                                 &device->params.led_model, device->id, &this->model,
diff --git a/src/xrt/tracking/constellation/t_constellation_tracker_internal.hpp b/src/xrt/tracking/constellation/t_constellation_tracker_internal.hpp
index e7c7764b3..dec379598 100644
--- a/src/xrt/tracking/constellation/t_constellation_tracker_internal.hpp
+++ b/src/xrt/tracking/constellation/t_constellation_tracker_internal.hpp
@@ -296,6 +296,7 @@ public: // Methods (t_constellation_tracker.cpp)
 	tryDevicePose(Device *device,
 	              CameraSample &sample,
 	              DeviceState &device_state,
+	              bool need_matching_ids,
 	              const std::optional<xrt_space_relation> &Tcv_cam_device_prior,
 	              const xrt_pose &Tcv_cam_device_candidate);
 
-- 
2.56.0

