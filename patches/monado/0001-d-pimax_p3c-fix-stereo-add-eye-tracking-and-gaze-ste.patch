+/// Raw Vision (sub-device 0x05) command.
+struct VisionRaw<const ID: u8>(&'static [u8]);
+
+impl<const ID: u8> Command for VisionRaw<ID> {
+    const ID: u8 = ID;
+    fn cmd_opt(&self) -> PimaxSubDevice {
+        PimaxSubDevice::Vision
+    }
+    fn write_payload(&self, out: &mut Vec<u8>) {
+        out.extend_from_slice(self.0)
+    }
+}
+
+impl<const ID: u8> Query for VisionRaw<ID> {
+    type Response = Vec<u8>;
+    fn decode(result: CmdResult) -> pimax_protocol::Result<Vec<u8>> {
+        Ok(result.payload)
+    }
+}
+
+/// The Vision bring-up sequence the eye-tracking chip needs: without it the EyeChip enumerates and streams, but
+/// its eye cameras/illuminators stay idle and every gaze column is constant.  Panel, level, named-parameter and licence
+/// commands are deliberately left out.
 pub(super) fn activate_eye_tracker(cmd: &CommandDevice) -> Result<(), Error> {
+    for r in [
+        cmd.query(&VisionRaw::<0x3A>(&[0x03])),
+        cmd.query(&VisionRaw::<0x3A>(&[0x01])),
+        cmd.query(&VisionRaw::<0x3A>(&[0x00])),
+        cmd.query(&VisionRaw::<0x56>(&[0x0A])),
+        cmd.query(&VisionRaw::<0x56>(&[0x0B, 0, 0, 1])),
+        cmd.query(&VisionRaw::<0x1B>(&[0x01])),
+        cmd.query(&VisionRaw::<0x5B>(&[0x02, 0x02])),
+        cmd.query(&VisionRaw::<0x5A>(&[0x00])),
+    ] {
+        if let Err(e) = r {
+            warn!("eye tracking bring-up command failed: {e}");
+        }
+    }
     cmd.query(&CmdEyeTrackEnable)?;
     Ok(())
 }
