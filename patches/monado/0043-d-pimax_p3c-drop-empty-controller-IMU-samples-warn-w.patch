+                // no measurement, and a kick to the fusion if pushed.
+                if is_placeholder(sample) {
                     diag.imu_placeholder.fetch_add(1, Ordering::Relaxed);
                     continue;
                 }
@@ -293,6 +362,13 @@ impl OnReport for ControllerStatus {
                     }
                     a[3] += 1.0;
                 }
+                {
+                    let mut m = diag.gyro_motion.lock().unwrap();
+                    let change = m.map_or(0.0, |(prev, sum)| {
