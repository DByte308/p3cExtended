 }
 
+/// `PIMAX_FOV_PERCENT` (50..100, default 100): selectable FOV levels. Scales the view tangents (so the image
+/// is cropped, the compositor fills the rest with black) and the recommended render size by the same ratio, keeping
+/// the pixel density and saving GPU time.
+pub fn fov_scale() -> f32 {
+    static V: std::sync::OnceLock<f32> = std::sync::OnceLock::new();
+    *V.get_or_init(|| {
+        let pct = crate::util::option_num("PIMAX_FOV_PERCENT", 100).clamp(50, 100);
+        if pct != 100 {
+            info!("FOV level {pct} %");
+        }
+        pct as f32 / 100.0
+    })
+}
+
+/// `XRT_FOVEATION_INSET_DEG` (10..90, default 40): full width/height of the foveal inset. Shared with the OpenXR
+/// state tracker, which sizes the inset images from the angles this returns.
+fn inset_half_fov_rad() -> f32 {
+    static V: std::sync::OnceLock<f32> = std::sync::OnceLock::new();
+    *V.get_or_init(|| {
+        let deg = crate::util::option_num("XRT_FOVEATION_INSET_DEG", 40).clamp(10, 90);
+        info!("foveal inset {deg} deg");
+        (deg as f32 / 2.0).to_radians()
+    })
+}
+
+fn scale_fov(f: &mut xrt_fov, k: f32) {
+    if k >= 1.0 {
+        return;
+    }
+    for a in [&mut f.angle_left, &mut f.angle_right, &mut f.angle_up, &mut f.angle_down] {
+        *a = (a.tan() * k).atan();
+    }
+}
+
 pub unsafe fn setup_views(me: &mut PimaxHmd) {
     let PimaxDeviceConfigDisplay {
         native_width,
@@ -39,13 +73,10 @@ pub unsafe fn setup_views(me: &mut PimaxHmd) {
     hmd.blend_mode_count = 1;
 
     for (i, view) in hmd.views.iter_mut().enumerate().take(2) {
-        if view_rotation == 90 || view_rotation == 270 {
-            view.display.w_pixels = eye_h;
-            view.display.h_pixels = eye_w;
-        } else {
-            view.display.w_pixels = eye_w;
-            view.display.h_pixels = eye_h;
-        }
+        // The recommended render size follows the FOV level (same pixel density over a smaller FOV).
+        let (dw, dh) = if view_rotation == 90 || view_rotation == 270 { (eye_h, eye_w) } else { (eye_w, eye_h) };
+        view.display.w_pixels = ((dw as f32 * fov_scale()) as u32) & !1;
+        view.display.h_pixels = ((dh as f32 * fov_scale()) as u32) & !1;
         view.viewport.x_pixels = eye_w * i as u32;
         view.viewport.y_pixels = 0;
         view.viewport.w_pixels = eye_w;
@@ -104,6 +135,9 @@ pub unsafe extern "C" fn pimax_get_view_poses(
     }
     let poses = unsafe { std::slice::from_raw_parts_mut(out_poses, view_count as usize) };
     let fovs = unsafe { std::slice::from_raw_parts_mut(out_fovs, view_count as usize) };
+    for f in fovs.iter_mut().take(2) {
+        scale_fov(f, fov_scale());
+    }
     for (i, pose) in poses.iter_mut().enumerate().take(2) {
         // Rotation about +y: positive turns the left eye's forward vector (-z) towards -x.
         let outwards = if i == 0 { 1. } else { -1. };
@@ -128,7 +162,7 @@ pub unsafe extern "C" fn pimax_get_view_poses(
             e.touch();
             e.gaze()
         });
-        let half = INSET_HALF_FOV_DEG.to_radians();
+        let half = inset_half_fov_rad();
         for i in 0..2 {
             let eye_pos = poses[i].position;
             poses[2 + i] = xrt_pose {
@@ -144,6 +178,3 @@ pub unsafe extern "C" fn pimax_get_view_poses(
     xrt_result::XRT_SUCCESS
 }
 
-/// Foveal inset half-FOV in degrees; about a third of the full view.
-const INSET_HALF_FOV_DEG: f32 = 20.0;
