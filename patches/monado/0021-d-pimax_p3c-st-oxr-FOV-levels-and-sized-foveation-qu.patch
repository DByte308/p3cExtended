 DEBUG_GET_ONCE_NUM_OPTION(scale_percentage, "OXR_VIEWPORT_SCALE_PERCENTAGE", 100)
+DEBUG_GET_ONCE_NUM_OPTION(foveation_context_percent, "XRT_FOVEATION_CONTEXT_PERCENT", 100)
+DEBUG_GET_ONCE_NUM_OPTION(foveation_inset_density_percent, "XRT_FOVEATION_INSET_DENSITY_PERCENT", 100)
 
 
 static double
@@ -155,8 +158,82 @@ fill_in_view_config_properties(struct oxr_logger *log,
 	props->view_count = view_config->view_count;
 }
 
+static uint32_t
+quad_size(double px, uint32_t max_px)
+{
+	uint32_t v = (uint32_t)lround(px);
+	v = MAX(v, 16u);
+	v = MIN(v, max_px);
+	return v & ~1u;
+}
+
+static double
+tan_span_h(const struct xrt_fov *f)
+{
+	return tan(f->angle_right) - tan(f->angle_left);
+}
+
+static double
+tan_span_v(const struct xrt_fov *f)
+{
+	return tan(f->angle_up) - tan(f->angle_down);
+}
+
+/*!
+ * Size the four quad views. Context views: the stereo size times XRT_FOVEATION_CONTEXT_PERCENT. Inset views: when the
+ * device produces quad views itself, the stereo pixel density (in tangent space) over the inset's angles times
+ * XRT_FOVEATION_INSET_DENSITY_PERCENT, so the inset is no longer a full-resolution copy of the eye. The angles come
+ * from one get_view_poses(QUAD) call, so the driver stays the single source of truth for the inset FOV.
+ */
+static void
+size_quad_views(struct oxr_logger *log, struct xrt_device *head, struct oxr_view_config_properties *props)
+{
+	const double context = CLAMP((double)debug_get_num_option_foveation_context_percent(), 25.0, 100.0) / 100.0;
+	const double density = CLAMP((double)debug_get_num_option_foveation_inset_density_percent(), 25.0, 200.0) / 100.0;
+
+	XrViewConfigurationView *v = props->views;
+	const uint32_t stereo_w[2] = {v[0].recommendedImageRectWidth, v[1].recommendedImageRectWidth};
+	const uint32_t stereo_h[2] = {v[0].recommendedImageRectHeight, v[1].recommendedImageRectHeight};
+
+	for (uint32_t i = 0; i < 2; i++) {
+		v[i].recommendedImageRectWidth = quad_size(stereo_w[i] * context, v[i].maxImageRectWidth);
+		v[i].recommendedImageRectHeight = quad_size(stereo_h[i] * context, v[i].maxImageRectHeight);
+	}
+
+	if (head == NULL || !head->supported.get_views_quad) {
+		return;
+	}
+
+	struct xrt_vec3 eye_relation = {0.063f, 0.0f, 0.0f};
+	struct xrt_space_relation head_relation = XRT_SPACE_RELATION_ZERO;
+	struct xrt_fov fovs[4] = {0};
+	struct xrt_pose poses[4] = {0};
+	xrt_result_t xret = xrt_device_get_view_poses(head, &eye_relation, os_monotonic_get_ns(), XRT_VIEW_TYPE_QUAD, 4,
+	                                              &head_relation, fovs, poses);
+	if (xret != XRT_SUCCESS) {
+		oxr_log(log, "Could not get quad view angles, the inset keeps the stereo size.");
+		return;
+	}
+
+	for (uint32_t i = 0; i < 2; i++) {
+		const double kw = tan_span_h(&fovs[2 + i]) / tan_span_h(&fovs[i]);
+		const double kh = tan_span_v(&fovs[2 + i]) / tan_span_v(&fovs[i]);
+		if (!(kw > 0.0) || !(kh > 0.0)) {
+			continue;
+		}
+		v[2 + i].recommendedImageRectWidth = quad_size(stereo_w[i] * kw * density, v[2 + i].maxImageRectWidth);
+		v[2 + i].recommendedImageRectHeight = quad_size(stereo_h[i] * kh * density, v[2 + i].maxImageRectHeight);
+	}
+
+	U_LOG_I("Quad views: context %ux%u (%.0f %%), inset %ux%u (%.0f %% density); stereo %ux%u",
+	        v[0].recommendedImageRectWidth, v[0].recommendedImageRectHeight, context * 100.0,
+	        v[2].recommendedImageRectWidth, v[2].recommendedImageRectHeight, density * 100.0, stereo_w[0],
+	        stereo_h[0]);
+}
+
 static void
 fill_in_view_emulated_quadview_config_properties(struct oxr_logger *log,
+                                                 struct xrt_device *head,
                                                  struct oxr_view_config_properties *props,
                                                  const struct xrt_system_compositor_info *info,
                                                  const struct xrt_view_config *stereo_view_config)
@@ -174,6 +251,8 @@ fill_in_view_emulated_quadview_config_properties(struct oxr_logger *log,
 	fill_in_view_config_properties_views(log, props->views + 2, stereo_view_config);
 
 	props->view_count = 4;
+
+	size_quad_views(log, head, props);
 }
 
 static bool
@@ -317,6 +396,7 @@ oxr_system_fill_view_configs_locked(struct oxr_logger *log, uint32_t view_count,
 			assert(sys->view_config_count < XRT_MAX_COMPOSITOR_VIEW_CONFIGS_COUNT);
 			fill_in_view_emulated_quadview_config_properties( //
 			    log,                                          //
+			    GET_STATIC_XDEV_BY_ROLE(sys, head),           //
 			    &sys->view_configs[sys->view_config_count],   //
 			    info,                                         //
 			    stereo_view_config);                          //
