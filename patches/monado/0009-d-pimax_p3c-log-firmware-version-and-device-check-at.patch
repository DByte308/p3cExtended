+/// Firmware and self-test results, for the log and the status file. Failures only warn.
+#[derive(Clone, Default)]
+pub struct DeviceInfo {
+    pub firmware: Option<String>,
+    pub device_check: Option<String>,
+}
+
+fn printable_or_hex(bytes: &[u8]) -> String {
+    let end = bytes.iter().rposition(|&b| b != 0).map_or(0, |i| i + 1);
+    let bytes = &bytes[..end];
+    if !bytes.is_empty() && bytes.iter().all(|b| (0x20..0x7F).contains(b)) {
+        String::from_utf8_lossy(bytes).into_owned()
+    } else {
+        bytes.iter().map(|b| format!("{b:02X}")).collect::<Vec<_>>().join(" ")
+    }
+}
+
+impl DeviceInfo {
+    fn query(cmd: &CommandDevice) -> Self {
+        let mut firmware = Vec::new();
+        for (name, device) in [("HMD", PimaxSubDevice::Hmd), ("MCU", PimaxSubDevice::MCU)] {
+            match cmd.query(&CmdSoftVer { cmd_opt: device }) {
+                Ok(payload) => {
+                    let text = printable_or_hex(&payload);
+                    info!("software version ({name}): {text} (raw {payload:02X?})");
+                    if !text.is_empty() {
+                        firmware.push(if device == PimaxSubDevice::Hmd { text } else { format!("{name} {text}") });
+                    }
+                }
+                Err(e) => warn!("could not read the software version ({name}): {e}"),
+            }
+        }
+        let device_check = match cmd.query(&CmdDeviceCheck) {
+            Ok(check) => {
+                let text = check
+                    .subsystems()
+                    .filter(|&(_, exists, _)| exists)
+                    .map(|(name, _, ok)| format!("{name}={}", if ok { "ok" } else { "FAIL" }))
+                    .collect::<Vec<_>>()
+                    .join(", ");
+                info!("device check: {:#X}: {text}", check.status);
+                Some(text)
+            }
+            Err(e) => {
+                warn!("device check failed: {e}");
+                None
+            }
+        };
+        Self {
+            firmware: (!firmware.is_empty()).then(|| firmware.join("; ")),
+            device_check,
+        }
+    }
+}
+
 pub struct BringUp {
     pub calibration: Option<SlamCalibration>,
     pub lighthouse_plate: bool,
