+//! Periodic JSON status snapshot for external UIs (Envision): `$XDG_RUNTIME_DIR/pimax-p3c/status.json`.
+//! Written to `status.json.tmp` and renamed, so readers never see a partial file. Never removed.
+
+use super::bringup::DeviceInfo;
+use crate::device::constellation::Hand;
+use crate::device::tracking::Tracking;
+use crate::util::{now_ns, option_bool, option_str};
+use serde_json::{Value, json};
+use std::path::PathBuf;
+use std::time::{Duration, Instant, SystemTime, UNIX_EPOCH};
+
+const WRITE_INTERVAL: Duration = Duration::from_secs(1);
+const CONTROLLER_TIMEOUT_NS: i64 = 2_000_000_000;
+
+pub(super) struct StatusFile {
+    dir: PathBuf,
+    model: &'static str,
+    serial: String,
+    info: DeviceInfo,
+    refresh_hz: u8,
+    last_write: Option<Instant>,
+    warned: bool,
+}
+
+impl StatusFile {
+    pub(super) fn new(model: &'static str, serial: &str, info: DeviceInfo, refresh_hz: u8) -> Option<Self> {
+        let Some(runtime_dir) = std::env::var_os("XDG_RUNTIME_DIR").filter(|d| !d.is_empty()) else {
+            warn!("XDG_RUNTIME_DIR is not set; not writing the status file");
+            return None;
+        };
+        Some(Self {
+            dir: PathBuf::from(runtime_dir).join("pimax-p3c"),
+            model,
+            serial: serial.to_owned(),
+            info,
+            refresh_hz,
+            last_write: None,
+            warned: false,
+        })
+    }
+
+    /// Call often; writes at most once a second.
+    pub(super) fn tick(&mut self, tracking: &Tracking) {
+        if self.last_write.is_some_and(|t| t.elapsed() < WRITE_INTERVAL) {
+            return;
+        }
+        self.last_write = Some(Instant::now());
+        if let Err(e) = self.write(&self.snapshot(tracking)) {
+            if !self.warned {
+                warn!("could not write the status file in {}: {e}", self.dir.display());
+                self.warned = true;
+            }
+        }
+    }
+
+    fn write(&self, value: &Value) -> std::io::Result<()> {
+        std::fs::create_dir_all(&self.dir)?;
+        let tmp = self.dir.join("status.json.tmp");
+        std::fs::write(&tmp, serde_json::to_vec(value).unwrap_or_default())?;
+        std::fs::rename(tmp, self.dir.join("status.json"))
+    }
+
+    fn snapshot(&self, tracking: &Tracking) -> Value {
+        let now = now_ns();
+        let controller = |hand: Hand| {
+            let connected = tracking.controller_status[hand as usize]
+                .lock()
+                .unwrap()
+                .as_ref()
+                .is_some_and(|l| now - l.timestamp_ns < CONTROLLER_TIMEOUT_NS);
+            // The controller status report decode has no battery field.
+            json!({ "connected": connected, "battery_percent": null })
+        };
+        let ipd_mm = tracking.ipd_meters().map(|m| (m as f64 * 100_000.0).round() / 100.0);
+        let unix_ms = SystemTime::now().duration_since(UNIX_EPOCH).map_or(0, |d| d.as_millis() as u64);
+        json!({
+            "version": 1,
+            "updated_unix_ms": unix_ms,
+            "model": self.model,
+            "serial": self.serial,
+            "firmware": self.info.firmware,
+            "device_check": self.info.device_check,
+            "refresh_hz": self.refresh_hz,
+            "ipd_mm": ipd_mm,
+            "eye_tracking": {
+                "enabled": option_bool("PIMAX_EYE_TRACKING", true),
+                "calibrated": option_str("PIMAX_EYE_CALIB").is_some(),
+            },
+            "foveation": option_bool("PIMAX_FOVEATION", true),
+            "controllers": {
+                "left": controller(Hand::Left),
+                "right": controller(Hand::Right),
+            },
+        })
+    }
+}
