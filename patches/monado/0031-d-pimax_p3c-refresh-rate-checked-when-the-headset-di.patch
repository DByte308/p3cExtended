@@ -1,6 +1,7 @@
 use super::command::CommandSession;
 use pimax_protocol::cmd::get_video_ctrl_info::CmdGetVideoCtrlInfo;
 use pimax_protocol::cmd::video_ctrl::{CmdVideoCtrl, GpuType};
+use crate::device::hmd::PimaxP3CHmdDisplay;
 use pimax_protocol::{CommandDevice, Error};
 use std::thread::sleep;
 
@@ -23,16 +24,19 @@ fn gpu_type() -> GpuType {
     }
 }
 
-pub(super) fn start_video(cmd: &CommandDevice, rate_hz: u8) -> Result<(), Error> {
+/// Starts video and returns the refresh rate sent to the headset.
+pub(super) fn start_video(cmd: &CommandDevice, model: PimaxP3CHmdDisplay) -> Result<u8, Error> {
     cmd.query(&CmdVideoCtrl::SetWorkMode(gpu_type()))?;
     match cmd.query(&CmdGetVideoCtrlInfo) {
         Ok(payload) => debug!("GetVideoCtrlInfo -> {payload:02X?}"),
         Err(e) => warn!("GetVideoCtrlInfo: {e}"),
     }
     sleep(Duration::from_secs(6));
+    // Resolved here, not earlier: the headset display (and its EDID) may only be up after the work mode is set.
+    let rate_hz = super::refresh_hz(model);
     cmd.query(&CmdVideoCtrl::SetRate(rate_hz))?;
     cmd.query(&CmdVideoCtrl::Start)?;
-    Ok(())
+    Ok(rate_hz)
 }
 
 impl CommandSession {
