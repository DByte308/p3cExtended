--- /dev/null
+++ b/src/xrt/drivers/pimax_p3c/src/device/session/volume_keys.rs
@@ -0,0 +1,118 @@
+//! The headset's volume keys change the system output volume (default sound output, via `pactl`, which talks to
+//! PulseAudio and to PipeWire's pulse server). `PIMAX_VOLUME_KEYS=0` turns this off. Apps still see the keys as
+//! OpenXR inputs either way.
+//!
+//! Called for every headset status report, so it only tracks key edges here; `pactl` runs on a worker thread.
+
+use std::process::Command;
+use std::sync::mpsc::{Sender, channel};
+use std::sync::{Mutex, OnceLock};
+use std::time::{Duration, Instant};
+
+const ENABLE_ENV: &str = "PIMAX_VOLUME_KEYS";
+/// Volume change per step, in percent.
+const STEP: i32 = 5;
+/// A held key repeats after this delay, every `REPEAT_EVERY`.
+const REPEAT_AFTER: Duration = Duration::from_millis(500);
+const REPEAT_EVERY: Duration = Duration::from_millis(150);
+
+struct KeyState {
+    /// +1 up, -1 down, 0 none; and since when / last step.
+    held: i32,
+    since: Instant,
+    last_step: Instant,
+}
+
+static STATE: Mutex<Option<KeyState>> = Mutex::new(None);
+
+fn worker() -> Option<&'static Mutex<Sender<i32>>> {
+    static TX: OnceLock<Option<Mutex<Sender<i32>>>> = OnceLock::new();
+    TX.get_or_init(|| {
+        let (tx, rx) = channel::<i32>();
+        let spawned = std::thread::Builder::new().name("pimax-volume".into()).spawn(move || {
+            while let Ok(mut delta) = rx.recv() {
+                // Fold steps that queued up while pactl was running.
+                while let Ok(d) = rx.try_recv() {
+                    delta += d;
+                }
+                change_volume(delta);
+            }
+        });
+        match spawned {
+            Ok(_) => Some(Mutex::new(tx)),
+            Err(e) => {
+                warn!("volume keys: no worker thread: {e}");
+                None
+            }
+        }
+    })
+    .as_ref()
+}
+
+fn pactl(args: &[&str]) -> Option<String> {
+    let out = Command::new("pactl").args(args).env("LC_ALL", "C").output().ok()?;
+    out.status.success().then(|| String::from_utf8_lossy(&out.stdout).into_owned())
+}
+
+/// Highest channel volume of the default output in percent, from `pactl get-sink-volume`.
+fn current_percent() -> Option<i32> {
+    pactl(&["get-sink-volume", "@DEFAULT_SINK@"])?
+        .split('/')
+        .filter_map(|part| part.trim().strip_suffix('%')?.trim().parse::<i32>().ok())
+        .max()
+}
+
+fn change_volume(delta: i32) {
+    let Some(cur) = current_percent() else {
+        warn!("volume keys: pactl not available or no default output");
+        return;
+    };
+    // The keys never raise past 100 % (louder stays possible with the desktop's own controls), and a volume
+    // already above 100 % is only lowered by them, never pulled down by "up".
+    let target = if delta > 0 { if cur >= 100 { cur } else { (cur + delta).min(100) } } else { (cur + delta).max(0) };
+    if target == cur {
+        return;
+    }
+    let arg = format!("{target}%");
+    if pactl(&["set-sink-volume", "@DEFAULT_SINK@", &arg]).is_some() {
+        debug!("volume keys: {cur}% -> {target}%");
+    }
+}
+
+fn send(delta: i32) {
+    if let Some(tx) = worker() {
+        let _ = tx.lock().unwrap().send(delta);
+    }
+}
+
+/// Feed the current key state (from each headset status report).
+pub fn on_keys(up: bool, down: bool) {
+    let dir = match (up, down) {
+        (true, false) => STEP,
+        (false, true) => -STEP,
+        _ => 0,
+    };
+    let now = Instant::now();
+    let mut st = STATE.lock().unwrap();
+    let st = st.get_or_insert(KeyState { held: 0, since: now, last_step: now });
+    if dir != st.held {
+        st.held = dir;
+        st.since = now;
+        st.last_step = now;
+        if dir != 0 && enabled() {
+            send(dir);
+        }
+    } else if dir != 0
+        && now.duration_since(st.since) >= REPEAT_AFTER
+        && now.duration_since(st.last_step) >= REPEAT_EVERY
+    {
+        st.last_step = now;
+        if enabled() {
+            send(dir);
+        }
+    }
+}
+
+fn enabled() -> bool {
+    crate::live::get_str(ENABLE_ENV).is_none_or(|v| v.trim() != "0")
+}
