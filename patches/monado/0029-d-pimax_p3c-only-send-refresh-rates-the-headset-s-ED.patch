From 5f828453ec2978a4e3fca599ddec606eff58893e Mon Sep 17 00:00:00 2001
From: DByte308 <69403407+DByte308@users.noreply.github.com>
Date: Tue, 24 Nov 2026 14:13:06 +0100
Subject: [PATCH] d/pimax_p3c: only send refresh rates the headset's EDID lists

PIMAX_REFRESH_HZ went to the headset unchecked. The rate is now checked
against the modes the headset display advertises in its EDID (base and
CTA DTDs, DisplayID type I/VII timings). An unlisted rate falls back to
the model default; without a readable headset EDID only the model default
is used. Resolved once per process so video bring-up and the frame
interval agree.
---
 .../pimax_p3c/src/device/session/edid.rs      | 132 ++++++++++++++++++
 .../pimax_p3c/src/device/session/mod.rs       |  41 +++++-
 2 files changed, 172 insertions(+), 1 deletion(-)
 create mode 100644 src/xrt/drivers/pimax_p3c/src/device/session/edid.rs

diff --git a/src/xrt/drivers/pimax_p3c/src/device/session/edid.rs b/src/xrt/drivers/pimax_p3c/src/device/session/edid.rs
new file mode 100644
index 000000000..876b44f10
--- /dev/null
+++ b/src/xrt/drivers/pimax_p3c/src/device/session/edid.rs
@@ -0,0 +1,132 @@
+//! Refresh rates the headset's own display advertises in its EDID.
+//!
+//! The rate requested with PIMAX_REFRESH_HZ is sent to the headset as is, so a rate the panel cannot drive must
+//! never get that far. The headset lists the modes it supports in the EDID of its DisplayPort connector; only
+//! those rates are accepted.
+//!
+//! Parsed from the public VESA layouts: detailed timing descriptors in the base block and in CTA-861 extension
+//! blocks, and DisplayID type I (1.x) / type VII (2.x) timings in DisplayID extension blocks.
+
+use std::collections::BTreeSet;
+use std::fs;
+
+/// PnP manufacturer id of the headset display.
+const HEADSET_MANUFACTURER: &str = "PVR";
+
+fn manufacturer(edid: &[u8]) -> Option<String> {
+    if edid.len() < 128 || edid[..8] != [0x00, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0x00] {
+        return None;
+    }
+    let id = u16::from_be_bytes([edid[8], edid[9]]);
+    [10, 5, 0]
+        .iter()
+        .map(|s| char::from(b'A' - 1 + ((id >> s) & 0x1f) as u8))
+        .collect::<String>()
+        .into()
+}
+
+fn rate(clock_hz: f64, h_total: u32, v_total: u32) -> Option<u32> {
+    (h_total > 0 && v_total > 0 && clock_hz > 0.0).then(|| (clock_hz / (h_total as f64 * v_total as f64)).round() as u32)
+}
+
+/// 18-byte detailed timing descriptor (base block, CTA-861 block).
+fn dtd_rate(d: &[u8]) -> Option<u32> {
+    let clock = u16::from_le_bytes([d[0], d[1]]) as f64 * 10_000.0;
+    if clock == 0.0 {
+        return None;
+    }
+    let h = (d[2] as u32 | ((d[4] as u32 >> 4) << 8)) + (d[3] as u32 | ((d[4] as u32 & 0xf) << 8));
+    let v = (d[5] as u32 | ((d[7] as u32 >> 4) << 8)) + (d[6] as u32 | ((d[7] as u32 & 0xf) << 8));
+    rate(clock, h, v)
+}
+
+/// 20-byte DisplayID type I / type VII timing; `unit_hz` is 10 kHz (type I) or 1 kHz (type VII).
+fn displayid_rate(d: &[u8], unit_hz: f64) -> Option<u32> {
+    let le16 = |i: usize| u16::from_le_bytes([d[i], d[i + 1]]) as u32 + 1;
+    let clock = ((d[0] as u32 | (d[1] as u32) << 8 | (d[2] as u32) << 16) + 1) as f64 * unit_hz;
+    rate(clock, le16(4) + le16(6), le16(12) + le16(14))
+}
+
+/// All refresh rates (rounded to whole Hz) listed in one EDID.
+pub fn edid_rates(edid: &[u8]) -> BTreeSet<u32> {
+    let mut out = BTreeSet::new();
+    if manufacturer(edid).is_none() {
+        return out;
+    }
+    out.extend([54, 72, 90, 108].iter().filter_map(|&o| dtd_rate(&edid[o..o + 18])));
+    for block in edid[128..].chunks_exact(128) {
+        match block[0] {
+            // CTA-861: DTDs from the offset in byte 2 up to the checksum
+            0x02 => {
+                let start = block[2] as usize;
+                if (4..127).contains(&start) {
+                    out.extend(block[start..127].chunks_exact(18).filter_map(dtd_rate));
+                }
+            }
+            // DisplayID: section header (version, length, type, count), then data blocks (tag, rev, len, payload)
+            0x70 => {
+                let len = (block[2] as usize).min(122);
+                let mut i = 5;
+                while i + 3 <= 5 + len && i + 3 <= 127 {
+                    let (tag, plen) = (block[i], block[i + 2] as usize);
+                    let payload = &block[i + 3..(i + 3 + plen).min(127)];
+                    let unit = match tag {
+                        0x03 => Some(10_000.0),
+                        0x22 => Some(1_000.0),
+                        _ => None,
+                    };
+                    if let Some(unit) = unit {
+                        out.extend(payload.chunks_exact(20).filter_map(|d| displayid_rate(d, unit)));
+                    }
+                    if tag == 0 && plen == 0 {
+                        break;
+                    }
+                    i += 3 + plen;
+                }
+            }
+            _ => {}
+        }
+    }
+    out
+}
+
+/// Refresh rates of the connected headset display, or None if no headset EDID is visible.
+pub fn headset_rates() -> Option<BTreeSet<u32>> {
+    let mut found: Option<BTreeSet<u32>> = None;
+    for entry in fs::read_dir("/sys/class/drm").ok()?.flatten() {
+        let Ok(edid) = fs::read(entry.path().join("edid")) else { continue };
+        if manufacturer(&edid).as_deref() == Some(HEADSET_MANUFACTURER) {
+            found.get_or_insert_with(BTreeSet::new).extend(edid_rates(&edid));
+        }
+    }
+    found.filter(|r| !r.is_empty())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn dtd_rate_from_descriptor() {
+        // hand-built descriptor: clock 138.00 MHz, h 2560 + 160 blank, v 720 + 125 blank -> 60 Hz
+        let mut t = [0u8; 18];
+        t[0..2].copy_from_slice(&13800u16.to_le_bytes());
+        t[2] = (2560 & 0xff) as u8;
+        t[3] = 160;
+        t[4] = ((2560 >> 8) as u8) << 4;
+        t[5] = (720 & 0xff) as u8;
+        t[6] = 125;
+        t[7] = ((720 >> 8) as u8) << 4;
+        assert_eq!(dtd_rate(&t), Some(60));
+    }
+
+    #[test]
+    fn manufacturer_id() {
+        let mut e = vec![0u8; 128];
+        e[..8].copy_from_slice(&[0x00, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0x00]);
+        // "PVR": P=16 V=22 R=18 -> 0b0_10000_10110_10010
+        let id: u16 = (16 << 10) | (22 << 5) | 18;
+        e[8..10].copy_from_slice(&id.to_be_bytes());
+        assert_eq!(manufacturer(&e).as_deref(), Some("PVR"));
+    }
+}
diff --git a/src/xrt/drivers/pimax_p3c/src/device/session/mod.rs b/src/xrt/drivers/pimax_p3c/src/device/session/mod.rs
