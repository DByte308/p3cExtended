--- a/src/xrt/drivers/pimax_p3c/src/device/session/mod.rs
+++ b/src/xrt/drivers/pimax_p3c/src/device/session/mod.rs
@@ -1,6 +1,7 @@
 pub mod bringup;
 mod calibration;
 mod command;
+mod edid;
 mod extras;
 mod log;
 mod status_file;
@@ -10,6 +11,9 @@ mod video;
 
 use crate::device::hmd::PimaxP3CHmdDisplay;
 use crate::util::option_num;
+use std::sync::OnceLock;
+use std::thread::sleep;
+use std::time::Duration;
 use pimax_protocol::log::LogStream;
 use pimax_protocol::{CommandDevice, ControllerStatusStream, HmdStatusStream};
 
@@ -27,8 +31,43 @@ fn default_refresh_hz(model: PimaxP3CHmdDisplay) -> u8 {
         | PimaxP3CHmdDisplay::DreamAir => 90,
     }
 }
+/// The refresh rate sent to the headset. A requested rate (PIMAX_REFRESH_HZ) is only used if the headset's own
+/// display lists it in its EDID: the rate goes to the headset unchecked, and a rate the panel cannot drive must
+/// never reach it. Without a readable headset EDID only the model default is used. Resolved once per process.
 pub fn refresh_hz(model: PimaxP3CHmdDisplay) -> u8 {
-    option_num(REFRESH_HZ_ENV, default_refresh_hz(model) as i64) as u8
+    static RATE: OnceLock<u8> = OnceLock::new();
+    *RATE.get_or_init(|| {
+        let default = default_refresh_hz(model);
+        let requested = option_num(REFRESH_HZ_ENV, 0);
+        // The headset's display may still be coming up right after power-on.
+        let mut rates = edid::headset_rates();
+        for _ in 0..10 {
+            if rates.is_some() {
+                break;
+            }
+            sleep(Duration::from_millis(300));
+            rates = edid::headset_rates();
+        }
+        match (&rates, requested) {
+            (Some(r), _) => info!("headset display modes: {r:?} Hz"),
+            (None, _) => warn!("no headset EDID found; refresh rate stays at the model default {default} Hz"),
+        }
+        let supported = |hz: i64| rates.as_ref().is_some_and(|r| u32::try_from(hz).is_ok_and(|hz| r.contains(&hz)));
+        if requested > 0 && i64::from(default) != requested {
+            if supported(requested) {
+                return requested as u8;
+            }
+            warn!("{REFRESH_HZ_ENV}={requested} is not offered by this headset; using {default} Hz instead");
+        }
+        if rates.is_some() && !supported(default.into()) {
+            // The model default is not in the EDID either: pick the highest listed rate at or below it.
+            if let Some(&hz) = rates.as_ref().and_then(|r| r.range(..=u32::from(default)).next_back()) {
+                warn!("the model default {default} Hz is not offered by this headset; using {hz} Hz");
+                return hz as u8;
+            }
+        }
+        default
+    })
 }
 
 pub fn camera_hz() -> u8 {
