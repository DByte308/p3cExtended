@@ -1,6 +1,6 @@
 pub mod distortion;
 mod startup;
-mod views;
+pub(crate) mod views;
 
 use crate::device::camera::Cameras;
 use crate::device::hmd::distortion::PimaxDeviceConfig;
diff --git a/src/xrt/drivers/pimax_p3c/src/device/hmd/views.rs b/src/xrt/drivers/pimax_p3c/src/device/hmd/views.rs
index 989c88d53..082f637db 100644
--- a/src/xrt/drivers/pimax_p3c/src/device/hmd/views.rs
+++ b/src/xrt/drivers/pimax_p3c/src/device/hmd/views.rs
@@ -19,9 +19,9 @@ fn render_ipd_offset_m() -> f32 {
     })
 }
 
-/// `PIMAX_FOV_PERCENT` (50..100, default 100): selectable FOV levels. Scales the view tangents (so the image
-/// is cropped, the compositor fills the rest with black) and the recommended render size by the same ratio, keeping
-/// the pixel density and saving GPU time.
+/// `PIMAX_FOV_PERCENT` (50..100, default 100): selectable FOV levels. Scales the view tangents, so the image
+/// is cropped and the compositor fills the rest with black. The compositor scales the recommended render size by the
+/// same tangent ratio (view FOV vs distortion FOV), keeping the pixel density and saving GPU time.
 pub fn fov_scale() -> f32 {
     static V: std::sync::OnceLock<f32> = std::sync::OnceLock::new();
     *V.get_or_init(|| {
@@ -73,10 +73,15 @@ pub unsafe fn setup_views(me: &mut PimaxHmd) {
     hmd.blend_mode_count = 1;
 
     for (i, view) in hmd.views.iter_mut().enumerate().take(2) {
-        // The recommended render size follows the FOV level (same pixel density over a smaller FOV).
-        let (dw, dh) = if view_rotation == 90 || view_rotation == 270 { (eye_h, eye_w) } else { (eye_w, eye_h) };
-        view.display.w_pixels = ((dw as f32 * fov_scale()) as u32) & !1;
-        view.display.h_pixels = ((dh as f32 * fov_scale()) as u32) & !1;
+        // Full panel size: the compositor's scratch images cover the full distortion FOV. The recommended size for
+        // apps follows the (possibly narrower) view FOV, see comp_compositor.c.
+        if view_rotation == 90 || view_rotation == 270 {
+            view.display.w_pixels = eye_h;
+            view.display.h_pixels = eye_w;
+        } else {
+            view.display.w_pixels = eye_w;
+            view.display.h_pixels = eye_h;
+        }
         view.viewport.x_pixels = eye_w * i as u32;
         view.viewport.y_pixels = 0;
         view.viewport.w_pixels = eye_w;
diff --git a/src/xrt/drivers/pimax_p3c/src/device/session/status_file.rs b/src/xrt/drivers/pimax_p3c/src/device/session/status_file.rs
