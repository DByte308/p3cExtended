@@ -87,6 +87,7 @@ impl StatusFile {
                 "calibrated": option_str("PIMAX_EYE_CALIB").is_some(),
             },
             "foveation": option_bool("PIMAX_FOVEATION", true),
+            "fov_percent": (crate::device::hmd::views::fov_scale() * 100.0).round(),
             "controllers": {
                 "left": controller(Hand::Left),
                 "right": controller(Hand::Right),
diff --git a/src/xrt/include/xrt/xrt_compositor.h b/src/xrt/include/xrt/xrt_compositor.h
index 614a44d7c..25d77d7ac 100644
--- a/src/xrt/include/xrt/xrt_compositor.h
+++ b/src/xrt/include/xrt/xrt_compositor.h
@@ -2325,6 +2325,15 @@ struct xrt_system_compositor_info
 	 * devices.
 	 */
 	bool supports_emulated_quad_views_with_inset;
+
+	/*!
+	 * Quad view sizing, read by the service (XRT_FOVEATION_CONTEXT_PERCENT /
+	 * XRT_FOVEATION_INSET_DENSITY_PERCENT) so apps don't need the env vars:
+	 * context views as a percentage of the stereo size, inset views as a
+	 * percentage of the stereo pixel density. 0 means 100.
+	 */
+	uint32_t quad_context_percent;
+	uint32_t quad_inset_density_percent;
 };
 
 /*!
diff --git a/src/xrt/state_trackers/oxr/oxr_system.c b/src/xrt/state_trackers/oxr/oxr_system.c
index 1fa2b6d03..600d6f490 100644
--- a/src/xrt/state_trackers/oxr/oxr_system.c
+++ b/src/xrt/state_trackers/oxr/oxr_system.c
@@ -40,8 +40,6 @@
  */
 
 DEBUG_GET_ONCE_NUM_OPTION(scale_percentage, "OXR_VIEWPORT_SCALE_PERCENTAGE", 100)
-DEBUG_GET_ONCE_NUM_OPTION(foveation_context_percent, "XRT_FOVEATION_CONTEXT_PERCENT", 100)
-DEBUG_GET_ONCE_NUM_OPTION(foveation_inset_density_percent, "XRT_FOVEATION_INSET_DENSITY_PERCENT", 100)
 
 
 static double
@@ -180,16 +178,21 @@ tan_span_v(const struct xrt_fov *f)
 }
 
 /*!
- * Size the four quad views. Context views: the stereo size times XRT_FOVEATION_CONTEXT_PERCENT. Inset views: when the
+ * Size the four quad views. Context views: the stereo size times info->quad_context_percent. Inset views: when the
  * device produces quad views itself, the stereo pixel density (in tangent space) over the inset's angles times
- * XRT_FOVEATION_INSET_DENSITY_PERCENT, so the inset is no longer a full-resolution copy of the eye. The angles come
- * from one get_view_poses(QUAD) call, so the driver stays the single source of truth for the inset FOV.
+ * info->quad_inset_density_percent, so the inset is no longer a full-resolution copy of the eye. The percentages are
+ * read by the service (env XRT_FOVEATION_*), so apps don't need them. The angles come from one get_view_poses(QUAD)
+ * call, so the driver stays the single source of truth for the inset FOV.
  */
 static void
-size_quad_views(struct oxr_logger *log, struct xrt_device *head, struct oxr_view_config_properties *props)
+size_quad_views(struct oxr_logger *log,
+                const struct xrt_system_compositor_info *info,
+                struct xrt_device *head,
+                struct oxr_view_config_properties *props)
 {
-	const double context = CLAMP((double)debug_get_num_option_foveation_context_percent(), 25.0, 100.0) / 100.0;
-	const double density = CLAMP((double)debug_get_num_option_foveation_inset_density_percent(), 25.0, 200.0) / 100.0;
+	const double context = (info->quad_context_percent ? CLAMP(info->quad_context_percent, 25u, 100u) : 100u) / 100.0;
+	const double density =
+	    (info->quad_inset_density_percent ? CLAMP(info->quad_inset_density_percent, 25u, 200u) : 100u) / 100.0;
 
 	XrViewConfigurationView *v = props->views;
 	const uint32_t stereo_w[2] = {v[0].recommendedImageRectWidth, v[1].recommendedImageRectWidth};
@@ -252,7 +255,7 @@ fill_in_view_emulated_quadview_config_properties(struct oxr_logger *log,
 
 	props->view_count = 4;
 
-	size_quad_views(log, head, props);
+	size_quad_views(log, info, head, props);
 }
 
 static bool
